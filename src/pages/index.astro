---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="High Tensile Fasteners & Auto Parts Manufacturer | Xiamen Carelong"
  description="Xiamen Carelong is a professional manufacturer and exporter of high tensile fasteners and auto parts since 2005. ISO 9001 certified, exporting hub bolts, forging parts, stamping parts worldwide."
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-text">
        <p class="hero-label">Manufacturer & Exporter - Xiamen, China</p>
        <h1 class="hero-title">High Tensile Fasteners & Auto Parts Manufacturer</h1>
        <p class="hero-desc">
          Xiamen Carelong Co., Ltd. is a manufacturer of bolts, nuts, forging parts, stamping parts, die casting parts, machining parts, and more. <strong class="iso-cert">ISO 9001</strong> certified, exporting worldwide.
        </p>
        <div class="hero-actions">
          <a href="/products" class="btn btn-white btn-lg">View Products</a>
          <a href="/contact" class="btn btn-outline-white btn-lg">Get a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="section section-alt">
    <div class="container">
      <div class="about-preview-grid">
        <div class="about-preview-text">
          <p class="section-eyebrow">About Carelong</p>
          <h2>Your Trusted Partner in Auto Parts Manufacturing</h2>
          <p>
            Xiamen Carelong Co., Ltd. is a manufacturer and exporter of quality forging parts and high tensile auto fasteners. Our undercarriage spare parts are widely used on construction machinery, such as Caterpillar and Komatsu loaders.
          </p>
          <p>
            Our wheel bolts are used by Hino, Mitsubishi Fuso, Benz, Volvo, Nissan and Suzuki. We also source and assemble machinery parts, stamping parts, die casting parts and welding parts on demand. Products are exported to North America, Europe, Southeast Asia, and Taiwan.
          </p>
          <div class="about-preview-stats">
            <div class="stat-item">
              <span class="stat-number">20+</span>
              <span class="stat-label">Years Experience</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">30+</span>
              <span class="stat-label">Countries Served</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">100+</span>
              <span class="stat-label">Happy Clients</span>
            </div>
          </div>
          <a href="/about" class="btn btn-primary">Learn More About Us</a>
        </div>
        <div class="about-preview-image">
          <div class="factory-carousel" id="factory-carousel">
            <img src="/images/about/factory/1.webp" alt="Factory 1" class="carousel-slide active" />
            <img src="/images/about/factory/2.webp" alt="Factory 2" class="carousel-slide" loading="lazy" />
            <img src="/images/about/factory/3.webp" alt="Factory 3" class="carousel-slide" loading="lazy" />
            <img src="/images/about/factory/4.webp" alt="Factory 4" class="carousel-slide" loading="lazy" />
            <img src="/images/about/factory/5.webp" alt="Factory 5" class="carousel-slide" loading="lazy" />
            <div class="carousel-dots">
              <span class="carousel-dot active" data-index="0"></span>
              <span class="carousel-dot" data-index="1"></span>
              <span class="carousel-dot" data-index="2"></span>
              <span class="carousel-dot" data-index="3"></span>
              <span class="carousel-dot" data-index="4"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Showcase -->
  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="section-eyebrow">Our Products</p>
        <h2>What We Manufacture</h2>
        <p>We specialize in precision-engineered auto parts with advanced manufacturing capabilities including cold heading and hot forging.</p>
      </header>
      <div class="grid-3 products-grid">
        <a href="/products/bolts-and-nuts" class="product-card">
          <img src="/images/products/bolts-and-nuts/hub-bolts/hub-bolt -(1).webp" alt="Bolts and Nuts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Bolts and Nuts</h3>
          <p>Hub bolts, plow bolts, track link bolts, segment bolts, hex nuts, flange nuts. High tensile 10.9 and 12.9 class.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/display-rack" class="product-card">
          <img src="/images/products/display-rack/supermarket-display-racks-01.webp" alt="Display Rack" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Display Rack</h3>
          <p>Custom display racks for supermarkets, retail stores, and trade shows — gondola shelving, pegboard, slatwall, and display tables.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/stamping-parts" class="product-card">
          <img src="/images/products/stamping-parts/stamping-parts-01.webp" alt="Stamping Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Stamping Parts</h3>
          <p>Precision metal stamping parts. Progressive die stamping with tight tolerances and high consistency.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/die-casting-parts" class="product-card">
          <img src="/images/products/die-casting-parts/die-casting-parts-01.webp" alt="Die Casting Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Die Casting Parts</h3>
          <p>Aluminum and zinc die casting with CNC machining. Complex geometries with high accuracy.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/forging-parts" class="product-card">
          <img src="/images/products/forging-parts/forging-parts-01.webp" alt="Forging Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Forging Parts</h3>
          <p>Hot forged components with superior grain flow. S40Cr and ML20MnTiB materials for 10.9 and 12.9 class.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/machining-parts" class="product-card">
          <img src="/images/products/machining-parts/machining-parts-01.webp" alt="Machining Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Machining Parts</h3>
          <p>Precision CNC machined parts with tight tolerances. Custom machining per drawing or sample.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/welding-parts" class="product-card">
          <img src="/images/products/welding-parts/welding-parts-01.webp" alt="Welding Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Welding Parts</h3>
          <p>Custom welding parts and fabricated components. MIG, TIG, and arc welding services.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/plastic-rubber-parts" class="product-card">
          <img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-01.webp" alt="Plastic and Rubber Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Plastic and Rubber Parts</h3>
          <p>Injection molded plastic parts and molded rubber components for automotive applications.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/tooling-and-moulds" class="product-card">
          <img src="/images/products/tooling-and-moulds/tooling-and-moulds-01.webp" alt="Tooling and Moulds" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Tooling and Moulds</h3>
          <p>Custom tooling and mould design and fabrication. Progressive dies, stamping moulds, and forging dies.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/heavy-equipment-parts" class="product-card">
          <img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-01.webp" alt="Heavy Equipment Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Heavy Equipment Parts</h3>
          <p>Undercarriage parts for CAT, Komatsu. Track chains, rollers, idlers, sprockets.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/auto-parts" class="product-card">
          <img src="/images/products/auto-parts/auto-parts-1.webp" alt="Auto Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Auto Parts</h3>
          <p>Automotive replacement parts and components for various vehicle makes and models.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>
        <a href="/products/other-parts" class="product-card">
          <img src="/images/products/other-parts/other-parts-01.webp" alt="Other Parts" loading="lazy" style="height: 200px; width:100%; object-fit: contain; margin-bottom: var(--space-4); background: #fff;" />
          <h3>Other Parts</h3>
          <p>Custom and specialty parts to your specifications. Sourcing and assembly services available on demand.</p>
          <span class="btn btn-primary" style="margin-top: var(--space-4);">View Products &rarr;</span>
        </a>

      </div>
    </div>
  </section>

  <!-- Capabilities Section -->
  <section class="section section-dark">
    <div class="container">
      <header class="section-header">
        <p class="section-eyebrow-light">Our Strength</p>
        <h2>Manufacturing Excellence</h2>
        <p>State-of-the-art facilities and rigorous quality control ensure every part meets international standards.</p>
      </header>
      <div class="grid-4 capabilities-grid">
        <div class="capability-item">
          <span class="capability-icon">⚙️</span>
          <h3>Cold Heading</h3>
          <p>Advanced cold forming technology for precision fasteners with superior mechanical properties.</p>
        </div>
        <div class="capability-item">
          <span class="capability-icon">🔥</span>
          <h3>Hot Forging</h3>
          <p>High-temperature forging for heavy-duty components with exceptional strength.</p>
        </div>
        <div class="capability-item">
          <span class="capability-icon">🔧</span>
          <h3>Machining</h3>
          <p>Precision CNC machining for secondary operations and custom part modifications.</p>
        </div>
        <div class="capability-item">
          <span class="capability-icon">✅</span>
          <h3>Quality Control</h3>
          <p>Multi-stage inspection process ensuring every product meets strict specifications.</p>
        </div>
      </div>
      <div class="text-center mt-8">
        <a href="/capabilities" class="btn btn-primary btn-lg">Explore Our Capabilities</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container text-center">
      <h2>Ready to Get Started?</h2>
      <p>Contact us today for a free quote, product samples, or to discuss your custom manufacturing needs.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
        <a href="/products" class="btn btn-primary btn-lg">Browse Products</a>
      </div>
      <p class="cta-contact">
        Or call us directly: <a href="tel:+865925185361">+86-592-5185361</a> - Jason Lin, Export Manager
      </p>
    </div>
  </section>

<script>
const carousel = document.getElementById('factory-carousel');
if (carousel) {
  const slides = carousel.querySelectorAll('.carousel-slide');
  const dots = carousel.querySelectorAll('.carousel-dot');
  let current = 0;
  let timer = setInterval(next, 3500);

  function show(index: number) {
    slides.forEach((s: Element) => s.classList.remove('active'));
    dots.forEach((d: Element) => d.classList.remove('active'));
    slides[index].classList.add('active');
    dots[index].classList.add('active');
    current = index;
  }

  function next() {
    show((current + 1) % slides.length);
  }

  dots.forEach((dot: Element, i: number) => {
    dot.addEventListener('click', () => {
      clearInterval(timer);
      show(i);
      timer = setInterval(next, 3500);
    });
  });
}
</script>
</BaseLayout>

<style>
/* Hero */
.hero {
  position: relative;
  color: #fff;
  padding: 0;
  overflow: hidden;
  min-height: auto;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #0F3060 0%, #1E40AF 100%);
}



.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-12);
}

.hero-text {
  max-width: 100%;
  padding: var(--space-8) var(--space-10);
  border-radius: var(--radius-xl, 16px);
  position: relative;
  z-index: 1;
}



.hero-label {
  display: inline-block;
  background: rgba(217, 119, 6, 0.2);
  border: 1px solid rgba(217, 119, 6, 0.4);
  color: #FCD34D;
  padding: var(--space-1) var(--space-3);
  border-radius: 100px;
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin-bottom: var(--space-4);
}

.hero-title {
  font-size: clamp(1.4rem, 3.6vw, 2.5rem);
  color: #fff;
  margin-bottom: var(--space-6);
  line-height: 1.2;
  white-space: nowrap;
  max-width: 100%;
}

@media (max-width: 1100px) {
  .hero-title { white-space: normal; }
}

.hero-desc {
  font-size: clamp(1rem, 2.5vw, 1.125rem);
  color: rgba(255,255,255,0.85);
  margin-bottom: var(--space-8);
  line-height: 1.7;
}

.hero-desc .iso-cert {
  color: #ffffff;
  font-weight: 700;
}

.hero-actions {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
}

/* About Preview */
.about-preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
  align-items: center;
}

.section-eyebrow {
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--color-secondary);
  margin-bottom: var(--space-3);
}

.section-eyebrow-light {
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: rgba(255,255,255,0.6);
  margin-bottom: var(--space-3);
}

.about-preview-text h2 { margin-bottom: var(--space-4); }

.about-preview-stats {
  display: flex;
  gap: var(--space-8);
  margin: var(--space-6) 0;
  padding: var(--space-6) 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-number {
  font-size: 2rem;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1;
  margin-bottom: var(--space-1);
}

.stat-label {
  font-size: 0.875rem;
  color: var(--color-text-muted);
}

/* Product Cards */
.products-grid { margin-top: 0; }

.product-card {
  display: block;
  text-decoration: none;
  color: inherit;
  padding: var(--space-4);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  transition: all 0.3s ease;
}

.product-card:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-lg);
  transform: translateY(-4px);
}

.product-card h3 {
  font-size: 1.125rem;
  margin-bottom: var(--space-2);
}

.product-card h3 a { color: var(--color-text); text-decoration: none; }
.product-card h3 a:hover { color: var(--color-primary); text-decoration: underline; }
.product-card p { font-size: 0.9375rem; color: var(--color-text-light); }

/* Capabilities */
.capabilities-grid {
  margin-bottom: var(--space-12);
}

.capability-item {
  text-align: center;
  padding: var(--space-6);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-lg);
  background: rgba(255,255,255,0.05);
  transition: all var(--transition-base);
}

.capability-item:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.2);
}


.capability-icon {
  font-size: 2.5rem;
  display: block;
  margin-bottom: var(--space-4);
}

.capability-item h3 {
  color: #fff;
  font-size: 1.125rem;
  margin-bottom: var(--space-2);
}

.capability-item p {
  color: #9CA3AF;
  font-size: 0.875rem;
}

/* CTA */
.cta-section {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  padding: var(--space-16) 0;
}

.cta-section h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-section p { font-size: 1.125rem; color: rgba(255,255,255,0.85); margin-bottom: var(--space-6); }

.cta-actions {
  display: flex;
  gap: var(--space-4);
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: var(--space-6);
}

.cta-contact {
  font-size: 0.9375rem !important;
  color: rgba(255,255,255,0.7) !important;
  margin: 0 !important;
}

.cta-contact a { color: #FCD34D; }

@media (max-width: 768px) {
  .about-preview-grid { grid-template-columns: 1fr; }

  /* Hero — mobile */
  .hero-content {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--space-6);
    padding: var(--space-8) 0;
  }

  .hero-text {
    max-width: 100%;
    padding: var(--space-4) var(--space-5);
  }

  .hero-label {
    font-size: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .hero-title {
    font-size: clamp(1.25rem, 5vw, 1.5rem);
    white-space: normal;
    line-height: 1.3;
  }

  .hero-desc {
    font-size: 0.95rem;
  }

  .hero-actions {
    flex-direction: column;
    width: 100%;
  }

  .hero-actions .btn {
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .hero-title {
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .hero-text {
    padding: var(--space-3) var(--space-4);
  }

  .hero-label {
    font-size: 0.7rem;
    padding: 0.25rem 0.75rem;
  }
}

/* Factory Carousel */
.factory-carousel {
  position: relative;
  width: 100%;
  height: 400px;
  border-radius: var(--radius-xl);
  overflow: hidden;
}
.carousel-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 0.6s ease;
}
.carousel-slide.active {
  opacity: 1;
}
.carousel-dots {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
}
.carousel-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  cursor: pointer;
  transition: background 0.3s;
}
.carousel-dot.active {
  background: #fff;
}
</style>