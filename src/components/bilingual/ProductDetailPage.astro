---
/**
 * Generic bilingual product detail page.
 * Used for: stamping-parts, die-casting-parts, forging-parts, machining-parts,
 *           welding-parts, plastic-rubber-parts, heavy-equipment-parts, auto-parts,
 *           other-parts, tooling-and-moulds
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../data/i18n/navigation';

interface Props {
  lang: Lang;
  titleEn: string;
  titleEs: string;
  descEn: string;
  descEs: string;
  heroImg: string;
  heroImgAltEn: string;
  heroImgAltEs: string;
  specs?: Array<{ labelEn: string; labelEs: string; value: string }>;
  featuresEn: string[];
  featuresEs: string[];
  applicationsEn: string[];
  applicationsEs: string[];
  gallery?: string[];
}
const {
  lang,
  titleEn, titleEs, descEn, descEs,
  heroImg, heroImgAltEn, heroImgAltEs,
  specs = [],
  featuresEn, featuresEs,
  applicationsEn, applicationsEs,
  gallery = [],
} = Astro.props;
const isEs = lang === 'es';

// H1 should be the short product name only — strip everything after the first " - ".
// Title is used as <title> tag (good for SEO), but H1 should be a clean short heading.
// Example: "Pernos de Rueda - Fabricante de Pernos de Cubo | Carelong" → "Pernos de Rueda"
const fullTitle = isEs ? titleEs : titleEn;
const h1Text = fullTitle.split(' - ')[0].split(' | ')[0].trim();
---
<BaseLayout lang={lang} title={isEs ? titleEs : titleEn} description={isEs ? descEs : descEn}>
  <header class="page-header">
    <div class="container">
      <h1>{h1Text}</h1>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-image" style="background:#fff;border-radius:var(--radius-xl);display:flex;align-items:center;justify-content:center;height:380px;overflow:hidden;">
          <img src={heroImg} alt={isEs ? heroImgAltEs : heroImgAltEn} style="max-height:100%;max-width:100%;object-fit:contain;" />
        </div>
        <div class="product-intro">
          <p class="eyebrow">{isEs ? 'Resumen del Producto' : 'Product Overview'}</p>
          <h2>{isEs ? titleEs : titleEn}</h2>
          <p>{isEs ? descEs : descEn}</p>
          <div class="product-actions">
            <a href={`/${lang}/contact`} class="btn btn-primary btn-lg">{isEs ? 'Solicitar Cotización' : 'Request a Quote'}</a>
            <a href={`/${lang}/products`} class="btn btn-primary btn-lg">{isEs ? 'Ver Todos los Productos' : 'View All Products'}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {specs.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{isEs ? 'Especificaciones' : 'Specifications'}</p>
          <h2>{isEs ? 'Detalles Técnicos' : 'Technical Details'}</h2>
        </header>
        <div class="specs-grid">
          {specs.map(spec => (
            <div class="spec-item">
              <span class="spec-label">{isEs ? spec.labelEs : spec.labelEn}</span>
              <span class="spec-value">{spec.value}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="two-col-grid">
        <div>
          <h3>{isEs ? 'Características' : 'Key Features'}</h3>
          <ul class="feature-list">
            {featuresEn.map((f, i) => <li>{isEs ? featuresEs[i] : f}</li>)}
          </ul>
        </div>
        <div>
          <h3>{isEs ? 'Aplicaciones' : 'Applications'}</h3>
          <ul class="feature-list">
            {applicationsEn.map((a, i) => <li>{isEs ? applicationsEs[i] : a}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{isEs ? 'Galería' : 'Product Gallery'}</p>
          <h2>{isEs ? 'Fotos del Producto' : 'Product Photos'}</h2>
        </header>
        <div class="gallery-grid">
          {gallery.map((img, i) => (
            <div class="gallery-item">
              <img src={img} alt="{isEs ? 'Producto ' : 'Product '}{i + 1}" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section cta-band">
    <div class="container text-center">
      <h2>{isEs ? '¿Necesita este producto?' : 'Need This Product?'}</h2>
      <p>{isEs ? 'Contáctenos para especificaciones y precios.' : 'Contact us for specifications and pricing.'}</p>
      <div class="cta-actions">
        <a href={`/${lang}/contact`} class="btn btn-primary btn-lg">{isEs ? 'Solicitar Cotización' : 'Request a Quote'}</a>
        <a href={`/${lang}/products`} class="btn btn-outline-primary btn-lg">{isEs ? 'Ver Todos los Productos' : 'View All Products'}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.page-header { background: linear-gradient(135deg, #0F3060 0%, #1E3A6E 100%); color: #fff; padding: var(--space-12) 0; text-align: center; }
.page-header h1 { color: #fff; font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 0; font-weight: 800; }
.section-header { text-align: center; margin-bottom: var(--space-10); }
.eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-secondary); margin-bottom: var(--space-3); }
.product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-10); align-items: center; }
.product-intro h2 { font-size: 2rem; margin-bottom: var(--space-4); }
.product-intro p { line-height: 1.7; margin-bottom: var(--space-6); }
.product-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
.specs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
.spec-item { display: flex; flex-direction: column; padding: var(--space-4); background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.spec-label { font-size: 0.8rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
.spec-value { font-weight: 600; font-size: 0.9375rem; }
.two-col-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-10); }
.two-col-grid h3 { margin-bottom: var(--space-4); }
.feature-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
.feature-list li { padding-left: var(--space-5); position: relative; line-height: 1.6; }
.feature-list li::before { content: '✓'; position: absolute; left: 0; color: var(--color-primary); font-weight: 700; }

.gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
.gallery-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; }
.gallery-item img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }

.cta-band { background: var(--color-primary); color: #fff; }
.cta-band h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-band p { color: rgba(255,255,255,0.85); font-size: 1.125rem; margin-bottom: var(--space-6); }
.cta-actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }

.btn-outline-primary {
  display: inline-block;
  padding: var(--space-3) var(--space-6);
  color: #fff;
  border: 2px solid rgba(255,255,255,0.6);
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 0.9375rem;
  text-decoration: none;
  transition: all var(--transition-fast);
}
.btn-outline-primary:hover { background: rgba(255,255,255,0.1); border-color: #fff; }

@media (max-width: 768px) { .product-overview, .two-col-grid { grid-template-columns: 1fr; } .specs-grid { grid-template-columns: 1fr; } .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
