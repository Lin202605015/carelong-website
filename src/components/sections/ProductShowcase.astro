---
import { products } from '../../data/products';

const featuredProducts = products.filter(p => p.featured);
---

<section class="product-showcase">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Our Products</h2>
      <a href="/products/" class="view-all-link">
        View All Products
        <span class="arrow">→</span>
      </a>
    </div>

    <div class="product-grid">
      {featuredProducts.map((product) => (
        <article class="product-card">
          <div class="card-image">
            <div class="image-placeholder">
              <span class="placeholder-icon">🔩</span>
              <span class="placeholder-text">{product.name}</span>
            </div>
          </div>
          <div class="card-content">
            <span class="product-category">{product.category}</span>
            <h3 class="product-name">{product.name}</h3>
            <p class="product-desc">{product.description}</p>
            <a href={`/products/${product.slug}/`} class="learn-more-btn">
              Learn More
              <span class="btn-arrow">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .product-showcase {
    padding: 5rem 0;
    background-color: #ffffff;
    font-family: 'Inter', 'Noto Sans SC', system-ui, sans-serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  /* Section Header */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: #1a2332;
    letter-spacing: -0.02em;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #e85a1f;
    transition: all 0.2s ease;
  }

  .view-all-link:hover {
    color: #d44f1a;
    gap: 0.75rem;
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .view-all-link:hover .arrow {
    transform: translateX(4px);
  }

  /* Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  /* Product Card */
  .product-card {
    background-color: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .product-card:hover {
    border-color: transparent;
    box-shadow: 0 12px 40px rgba(0,0,0,0.1);
    transform: translateY(-4px);
  }

  /* Card Image */
  .card-image {
    aspect-ratio: 4/3;
    overflow: hidden;
    background-color: #f5f6f8;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: #9ca3af;
    background: linear-gradient(135deg, #f5f6f8 0%, #e8eaed 100%);
  }

  .placeholder-icon {
    font-size: 3rem;
    opacity: 0.5;
  }

  .placeholder-text {
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Card Content */
  .card-content {
    padding: 1.5rem;
  }

  .product-category {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: #e85a1f;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .product-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a2332;
    margin-bottom: 0.75rem;
  }

  .product-desc {
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* Learn More Button */
  .learn-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #e85a1f;
    transition: all 0.2s ease;
  }

  .learn-more-btn:hover {
    color: #d44f1a;
    gap: 0.75rem;
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .learn-more-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .product-showcase {
      padding: 4rem 0;
    }

    .section-title {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 600px) {
    .product-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .product-showcase {
      padding: 3rem 0;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .card-content {
      padding: 1.25rem;
    }

    .product-name {
      font-size: 1.125rem;
    }
  }
</style>