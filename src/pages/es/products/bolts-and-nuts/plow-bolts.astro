---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';

const images = [
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-01-v2.webp', alt: 'Foto del producto Pernos de Arado' },
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-02-v2.webp', alt: 'Vista detallada de Pernos de Arado' },
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-03-v2.webp', alt: 'Aplicación de Pernos de Arado' },
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-04-v2.webp', alt: 'Detalle de Pernos de Arado' },
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-05-v2.webp', alt: 'Escena de aplicación de Pernos de Arado' },
];
---

<BaseLayout
  lang="es"
  title="Pernos de Arado — Pernos de Cabeza Avellanada para Maquinaria Agrícola y de Construcción | Carelong"
  description="Fabricante de pernos de arado con cabeza plana avellanada. Grado 8.8/10.9, acero de alta calidad. Servicio OEM para implementos agrícolas y equipos de movimiento de tierras."
>
  <Breadcrumb items={[
    { label: 'Productos', href: '/es/products' },
    { label: 'Pernos y Tuercas', href: '/es/products/bolts-and-nuts' },
    { label: 'Pernos de Arado' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Pernos de Arado</h1>
      <p>Pernos de cabeza avellanada para equipos agrícolas y de movimiento de tierras</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-gallery" id="productGallery">
          <div class="gallery-thumbs" aria-label="Imágenes del producto">
            {images.map((img, i) => (
              <button
                type="button"
                class={`thumb ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                aria-label={`Ver imagen ${i + 1}`}
              >
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
          <div class="gallery-stage" id="galleryStage">
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class={`stage-img ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
            <button type="button" class="stage-arrow stage-arrow-prev" aria-label="Imagen anterior" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="stage-arrow stage-arrow-next" aria-label="Imagen siguiente" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="zoom-hint" aria-hidden="true">Pase el cursor para ampliar y mover</div>
          </div>
        </div>
        <div class="product-intro">
          <p class="eyebrow">Descripción del Producto</p>
          <h2>Pernos de Arado</h2>
          <p>Los pernos de arado cuentan con una cabeza plana avellanada que queda al ras de la superficie, ideal para implementos agrícolas y equipos de movimiento de tierras donde las cabezas salientes causarían interferencia. Fabricados en acero de alta calidad con tratamiento térmico para mayor durabilidad.</p>

          <div class="product-badges">
            <span class="badge">Cabeza Avellanada</span>
            <span class="badge">Grado 8.8/10.9</span>
            <span class="badge">DIN 608</span>
          </div>

          <div class="product-actions">
            <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
            <a href="/es/products/bolts-and-nuts" class="btn btn-outline btn-lg">Volver a Pernos y Tuercas</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      

