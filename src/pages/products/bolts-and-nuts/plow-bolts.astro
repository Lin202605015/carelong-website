        <div class="spec-row"><div class="spec-name">thread type</div><div class="spec-value">UNC 5/8"–1 1/4"</div></div>
        <div class="spec-row"><div class="spec-name">strength grade</div><div class="spec-value">8.8, 10.9</div></div>
        <div class="spec-row"><div class="spec-name">material</div><div class="spec-value">Carbon Steel 45#, Alloy Steel 40Cr</div></div>
        <div class="spec-row"><div class="spec-name">surface treatment</div><div class="spec-value">Black</div></div>
        <div class="spec-row"><div class="spec-name">application</div><div class="spec-value">Plows, Scrapers, Blades, Agricultural implements</div></div>
      </div>

      <header class="section-header" style="margin-top: var(--space-12);">
        <h2>Plow Bolt Specifications</h2>
