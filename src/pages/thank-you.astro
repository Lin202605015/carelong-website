---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" title="Message Sent | Xiamen Carelong" noindex>
  <section class="ty-section">
    <div class="container text-center">
      <div class="ty-icon">✅</div>
      <h1>Message Sent!</h1>
      <p>Thank you for contacting Xiamen Carelong. We will respond to your inquiry within 24 hours.</p>
      <p class="ty-contact">If your inquiry is urgent, contact us directly:<br/>
      <a href="tel:+865925185361">+86-592-5185361</a> | <a href="mailto:Jason@carelong.com.cn">Jason@carelong.com.cn</a></p>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
  </section>
</BaseLayout>

<style>
.ty-section { padding: var(--space-16) 0; text-align: center; }
.ty-icon { font-size: 5rem; margin-bottom: var(--space-6); }
.ty-section h1 { color: var(--color-primary); margin-bottom: var(--space-4); }
.ty-section p { font-size: 1.125rem; color: var(--color-text-muted); margin-bottom: var(--space-4); }
.ty-contact { font-size: 0.9375rem !important; }
.ty-contact a { color: var(--color-primary); }
</style>
