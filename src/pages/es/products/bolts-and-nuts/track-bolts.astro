---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';

const images = [
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-01.webp', alt: 'Foto del producto Pernos de Oruga' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-02.webp', alt: 'Vista detallada de Pernos de Oruga' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-03.webp', alt: 'Aplicación de Pernos de Oruga' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-04.webp', alt: 'Detalle de Pernos de Oruga' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-05.webp', alt: 'Escena de aplicación de Pernos de Oruga' },
