---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

interface ProductCategory {
  slug: string;
  name: string;
  image: string;
  description: string;
  count: number;
  filter: string;
}

const categories: ProductCategory[] = [
  // Bolts and Nuts - 5 subcategories
  {
    slug: 'bolts-and-nuts/hub-bolts',
    name: 'Pernos de Maza',
    image: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt -(1).webp',
    description: 'Pernos de maza de alta resistencia para aplicaciones automotrices y de equipo pesado. Disponibles en varios tamaños y especificaciones.',
    count: 5,
    filter: 'fasteners',
  },
  {
    slug: 'bolts-and-nuts/plow-bolts',
    name: 'Pernos de Arado',
    image: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-01.webp',
    description: 'Pernos de arado para tren de rodaje de maquinaria de construcción. Duraderos y fiables para aplicaciones de servicio pesado.',
    count: 5,
    filter: 'fasteners',
  },
  {
    slug: 'bolts-and-nuts/track-bolts',
    name: 'Pernos de Oruga',
    image: '/images/products/bolts-and-nuts/track-bolts/track-bolt-01.webp',
    description: 'Pernos de eslabón de cadena para excavadoras y bulldozers. Alta resistencia clase 10.9 y 12.9.',
    count: 5,
    filter: 'fasteners',
  },
  {
    slug: 'bolts-and-nuts/segment-bolts',
    name: 'Pernos de Segmento',
    image: '/images/products/bolts-and-nuts/segment-bolts/segment-bolt-01.webp',
    description: 'Pernos de segmento para tren de rodaje de equipo pesado. Fabricados con precisión según especificaciones OEM.',
    count: 5,
    filter: 'fasteners',
  },
  {
    slug: 'bolts-and-nuts/hex-nuts',
    name: 'Tuercas Hexagonales',
    image: '/images/products/bolts-and-nuts/hex-nuts/hex-nuts-01.webp',
    description: 'Tuercas hexagonales estándar en acero al carbono y acero aleado. M6-M36, Grado 8/10, galvanizadas y acabado negro. DIN 934, ISO 4032.',
    count: 5,
    filter: 'fasteners',
  },
  {
    slug: 'bolts-and-nuts/flange-nuts',
    name: 'Tuercas de Brida',
    image: '/images/products/bolts-and-nuts/flange-nuts/flange-nuts-01.webp',
    description: 'Tuercas de brida hexagonal y tuercas de brida dentadas con base de arandela integrada. DIN 6923, ISO 4161. Acero al carbono y aleado.',
    count: 5,
    filter: 'fasteners',
  },
  {
    slug: 'bolts-and-nuts/nylon-nuts',
    name: 'Tuercas de Nylon',
    image: '/images/products/bolts-and-nuts/nylon-nuts/nylon-nuts-01.webp',
    description: 'Tuercas autoblocantes con inserto de nylon (tuercas de par de apriete prevalente). DIN 982, ISO 10511. M4-M24, Grado 8/10.',
    count: 5,
    filter: 'fasteners',
  },
  {
    slug: 'bolts-and-nuts/wheel-nuts',
    name: 'Tuercas de Rueda',
    image: '/images/products/bolts-and-nuts/wheel-nuts/wheel-nuts-01.webp',
    description: 'Tuercas de rueda para camiones, remolques y vehículos comerciales. M18-M27, rosca derecha e izquierda. Compatibles con BPW, SAF, Meritor.',
    count: 5,
    filter: 'fasteners',
  },
  {
    slug: 'bolts-and-nuts/slotted-nuts',
    name: 'Tuercas Ranuradas',
    image: '/images/products/bolts-and-nuts/slotted-nuts/slotted-nuts-01.webp',
    description: 'Tuercas casquillo y tuercas hexagonales ranuradas para bloqueo con pasador de horquilla. DIN 935, ISO 4037. M6-M36, Grado 8/10.',
    count: 5,
    filter: 'fasteners',
  },
    // Display Fixture - 5 subcategories
  {
    slug: 'display-rack/supermarket-display-racks',
    name: 'Estanterías para Supermercados',
    image: '/images/products/display-rack/supermarket-display-racks-01.webp',
    description: 'Sistemas de estanterías tipo góndola de alta resistencia para supermercados y tiendas de comestibles. Diseñados para alto tráfico y máxima visibilidad del producto.',
    count: 5,
    filter: 'parts',
  },
  {
    slug: 'display-rack/wall-mounted-storage-racks',
    name: 'Expositores de Pegboard y Slatwall',
    image: '/images/products/display-rack/pegboard-slatwall-01.webp',
    description: 'Paneles versátiles de pegboard y slatwall con ganchos, estanterías y accesorios. Ideales para paredes comerciales, talleres y ferias.',
    count: 5,
    filter: 'parts',
  },
  {
    slug: 'display-rack/clothing-display-racks',
    name: 'Expositores de Ropa',
    image: '/images/products/display-rack/clothing-racks-01.webp',
    description: 'Elegantes expositores de prendas para boutiques, showrooms y ferias. Varios estilos incluyendo racks redondos, rieles de ropa y stands de exhibición.',
    count: 5,
    filter: 'parts',
  },
  {
    slug: 'display-rack/wooden-display-racks',
    name: 'Expositores de Madera',
    image: '/images/products/display-rack/wooden-racks-01.webp',
    description: 'Elegantes expositores de madera que combinan marcos metálicos con estanterías de madera. Perfectos para boutiques, tiendas de regalos y entornos comerciales de gama alta.',
    count: 5,
    filter: 'parts',
  },
  {
    slug: 'display-rack/newspaper-magazine-racks',
    name: 'Mesas y Stands de Exhibición',
    image: '/images/products/display-rack/newspaper-racks-01.webp',
    description: 'Mesas y stands de exhibición independientes para publicaciones, folletos y mercancía promocional. Ideales para librerías, quioscos, bibliotecas y pisos comerciales.',
    count: 5,
    filter: 'parts',
  },
  // Other product categories
  {
    slug: 'stamping-parts',
    name: 'Piezas Estampadas',
    image: '/images/products/stamping-parts/stamping-parts-01.webp',
    description: 'Piezas de estampado de metal de precisión para aplicaciones automotrices e industriales. Estampado con troquel progresivo con tolerancias ajustadas y alta consistencia.',
    count: 8,
    filter: 'parts',
  },
  {
    slug: 'die-casting-parts',
    name: 'Piezas de Fundición a Presión',
    image: '/images/products/die-casting-parts/die-casting-parts-01.webp',
    description: 'Componentes de fundición a presión de aluminio y zinc con mecanizado CNC para geometrías complejas que requieren alta precisión dimensional.',
    count: 16,
    filter: 'parts',
  },
  {
    slug: 'forging-parts',
    name: 'Piezas Forjadas',
    image: '/images/products/forging-parts/forging-parts-01.webp',
    description: 'Componentes forjados en caliente con flujo de grano superior. Nos especializamos en clase de alta resistencia 10.9 y 12.9 utilizando materiales S40Cr y ML20MnTiB.',
    count: 12,
    filter: 'fasteners',
  },
  {
    slug: 'machining-parts',
    name: 'Piezas Mecanizadas',
    image: '/images/products/machining-parts/machining-parts-01.webp',
