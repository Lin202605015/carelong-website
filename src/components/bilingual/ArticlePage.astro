---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../data/i18n/navigation';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  category: string;
  date: string;
  dateDisplay: string;
  image: string;
  imageAlt: string;
  breadcrumbLabel: string;
}

const { lang, title, description, category, date, dateDisplay, image, imageAlt, breadcrumbLabel } = Astro.props;
const isEs = lang === 'es';
const baseUrl = isEs ? '/es/news' : '/news';
---

<BaseLayout lang={lang} title={`${title} | Carelong`} description={description} breadcrumbs={[
  { label: isEs ? 'Inicio' : 'Home', href: isEs ? '/es' : '/' },
  { label: isEs ? 'Noticias' : 'News', href: baseUrl },
  { label: breadcrumbLabel }
]}>
  <article class="news-article">
    <div class="article-hero">
      <div class="container">
        <div class="article-meta">
          <span class="post-category">{category}</span>
          <time datetime={date}>{dateDisplay}</time>
        </div>
        <h1>{title}</h1>
      </div>
    </div>

    <div class="container">
      <div class="article-body">
        <img src={image} alt={imageAlt} class="article-cover" />
        <slot />
      </div>

      <div class="article-footer">
        <a href={baseUrl} class="back-link">← {isEs ? 'Volver a Noticias' : 'Back to News'}</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
.article-hero { background: linear-gradient(135deg, #0F3060 0%, #1E3A6E 100%); color: #fff; padding: var(--space-10) 0 var(--space-8); }
.article-hero h1 { color: #fff; font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: 800; line-height: 1.3; max-width: 800px; }
.article-meta { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); font-size: 0.8125rem; }
.article-meta time { color: rgba(255,255,255,0.75); }
.post-category { background: rgba(255,255,255,0.15); color: #fff; padding: var(--space-1) var(--space-3); border-radius: 100px; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; }
.article-body { max-width: 800px; margin: 0 auto; padding: var(--space-8) 0 var(--space-12); }
.article-cover { width: 100%; border-radius: var(--radius-xl); margin-bottom: var(--space-8); object-fit: cover; max-height: 400px; }
.article-body :global(h2) { font-size: 1.5rem; font-weight: 700; margin: var(--space-8) 0 var(--space-4); color: var(--color-text); }
.article-body :global(h3) { font-size: 1.25rem; font-weight: 600; margin: var(--space-6) 0 var(--space-3); color: var(--color-text); }
.article-body :global(p) { font-size: 1rem; line-height: 1.8; color: var(--color-text-light); margin-bottom: var(--space-4); }
.article-body :global(ul) { margin: 0 0 var(--space-4) var(--space-6); }
.article-body :global(li) { font-size: 1rem; line-height: 1.7; color: var(--color-text-light); margin-bottom: var(--space-2); }
.article-body :global(strong) { color: var(--color-text); font-weight: 600; }
.article-body :global(blockquote) { border-left: 4px solid var(--color-primary); padding: var(--space-4) var(--space-6); margin: var(--space-6) 0; background: var(--color-bg-alt); border-radius: 0 var(--radius-md) var(--radius-md) 0; font-style: italic; color: var(--color-text-light); }
.article-body :global(table) { width: 100%; border-collapse: collapse; margin: var(--space-6) 0; font-size: 0.875rem; }
.article-body :global(th) { background: var(--color-primary); color: #fff; padding: var(--space-3); text-align: left; font-weight: 600; }
.article-body :global(td) { padding: var(--space-3); border-bottom: 1px solid var(--color-border); }
.article-body :global(tr:nth-child(even) td) { background: var(--color-bg-alt); }
.article-footer { max-width: 800px; margin: 0 auto var(--space-12); }
.back-link { display: inline-block; color: var(--color-primary); text-decoration: none; font-weight: 600; padding: var(--space-3) var(--space-5); border: 1px solid var(--color-primary); border-radius: var(--radius-md); transition: all var(--transition-base); }
.back-link:hover { background: var(--color-primary); color: #fff; }
</style>
