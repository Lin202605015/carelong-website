---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';

const images = [
  { src: '/images/products/bolts-and-nuts/segment-bolts/segment-bolt-01.webp', alt: 'Foto del producto Pernos de Segmento' },
  { src: '/images/products/bolts-and-nuts/segment-bolts/segment-bolt-02.webp', alt: 'Vista detallada de Pernos de Segmento' },
  { src: '/images/products/bolts-and-nuts/segment-bolts/segment-bolt-03.webp', alt: 'Aplicación de Pernos de Segmento' },
  { src: '/images/products/bolts-and-nuts/segment-bolts/segment-bolt-04.webp', alt: 'Detalle de Pernos de Segmento' },
  { src: '/images/products/bolts-and-nuts/segment-bolts/segment-bolt-05.webp', alt: 'Escena de aplicación de Pernos de Segmento' },
];
---

<BaseLayout
  lang="es"
  title="Pernos de Segmento — Pernos de Segmento de Piñón para Excavadoras y Bulldozers | Carelong"
  description="Fabricante de pernos de segmento para segmentos de piñón. Grado 10.9/12.9, rosca personalizada, acero aleado 42CrMo. Para tren de rodaje CAT, Komatsu."
>
  <Breadcrumb items={[
    { label: 'Productos', href: '/es/products' },
    { label: 'Pernos y Tuercas', href: '/es/products/bolts-and-nuts' },
    { label: 'Pernos de Segmento' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Pernos de Segmento</h1>
      <p>Pernos de segmento de piñón para el tren de rodaje de excavadoras y bulldozers</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-gallery" id="productGallery">
          <div class="gallery-thumbs" aria-label="Imágenes del producto">
            {images.map((img, i) => (
              <button
                type="button"
                class={`thumb ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                aria-label={`Ver imagen ${i + 1}`}
              >
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
          <div class="gallery-stage" id="galleryStage">
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class={`stage-img ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
            <button type="button" class="stage-arrow stage-arrow-prev" aria-label="Imagen anterior" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="stage-arrow stage-arrow-next" aria-label="Imagen siguiente" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="zoom-hint" aria-hidden="true">Pase el cursor para ampliar y mover</div>
          </div>
        </div>
        <div class="product-intro">
          <p class="eyebrow">Descripción del Producto</p>
          <h2>Pernos de Segmento</h2>
          <p>Los pernos de segmento son fijaciones especializadas utilizadas para asegurar los segmentos de piñón al cubo del piñón en maquinaria de oruga. Nuestros pernos de segmento cuentan con diseños de rosca personalizados y se fabrican con acero aleado de alta calidad 42CrMo para máxima durabilidad en aplicaciones exigentes.</p>

          <div class="product-badges">
            <span class="badge">Rosca Personalizada</span>
            <span class="badge">Grado 10.9/12.9</span>
            <span class="badge">Acero Aleado 42CrMo</span>
            <span class="badge">Servicio OEM</span>
          </div>

          <div class="product-actions">
            <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
            <a href="/es/products/bolts-and-nuts" class="btn btn-outline btn-lg">Volver a Pernos y Tuercas</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Especificaciones</p>
        <h2>Características Principales</h2>
      </header>
      <div class="spec-table spec-table-grid">
        <div class="spec-row"><div class="spec-name">tipo de rosca</div><div class="spec-value">Perfil de rosca personalizado según especificación OEM</div></div>
        <div class="spec-row"><div class="spec-name">grado de resistencia</div><div class="spec-value">10.9, 12.9</div></div>
        <div class="spec-row"><div class="spec-name">material</div><div class="spec-value">Acero Aleado 42CrMo, 40Cr</div></div>
        <div class="spec-row"><div class="spec-name">tratamiento superficial</div><div class="spec-value">Galvanizado, Dacromet, Fosfatado</div></div>
        <div class="spec-row"><div class="spec-name">marcas compatibles</div><div class="spec-value">CAT, Komatsu, Hitachi, Kobelco, Volvo</div></div>
        <div class="spec-row"><div class="spec-name">aplicación</div><div class="spec-value">Segmentos de piñón, Transmisión final, Tren de rodaje</div></div>
      </div>

      <header class="section-header" style="margin-top: var(--space-12);">
        <h2>Especificaciones de Pernos de Segmento</h2>
      </header>
      <div class="data-table-wrapper">
        <table class="data-table spec-table-8col">
          <thead>
            <tr>
              <th rowspan="2">Descripción</th>
              <th colspan="2">ESTILO</th>
              <th rowspan="2">Peso Neto Kg/Juego</th>
              <th rowspan="2">Juegos/Caja</th>
              <th rowspan="2">Peso Neto Kgs/Caja</th>
              <th rowspan="2">N.º OEM</th>
              <th rowspan="2">Medida para Tuercas</th>
            </tr>
            <tr>
              <th>Perno</th>
              <th>Tuerca</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>5/8"-18UNFX1 27/32"</td><td>C</td><td>b</td><td>0.158</td><td>180</td><td>28</td><td>3S8182/7H 3607</td><td>5/8"-18UNFX3/4"</td></tr>
            <tr><td>5/8"-18UNFX1 7/8"</td><td>C</td><td>b</td><td>0.248</td><td>100</td><td>25</td><td>1171616/1171617</td><td>&nbsp;</td></tr>
            <tr><td>5/8"-18UNFX2 7/64"</td><td>C</td><td>b</td><td>0.159</td><td>180</td><td>29</td><td>6V0937/7H3607</td><td>5/8"-18UNFX3/4"</td></tr>
            <tr><td>3/4"-16UNFX1 5/16"</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>180</td><td>28</td><td>&nbsp;</td><td>&nbsp;</td></tr>
            <tr><td>3/4"-16UNFX1 15/16"</td><td>F</td><td>b</td><td>0.248</td><td>100</td><td>25</td><td>1171617/7H 3608</td><td>3/4"-16UNFX3/4"</td></tr>
            <tr><td>3/4"-16UNFX2 5/16"</td><td>C</td><td>b</td><td>0.272</td><td>100</td><td>27</td><td>3S0336/7H3608</td><td>3/4"-16UNFX3/4"</td></tr>
            <tr><td>3/4"-16UNFX2 5/16"</td><td>B</td><td>b</td><td>0.272</td><td>100</td><td>27</td><td>/7H3608</td><td>3/4"-16UNFX3/4"</td></tr>
            <tr><td>3/4"-16UNFX2 13/32"</td><td>&nbsp;</td><td>&nbsp;</td><td>0.276</td><td>&nbsp;</td><td>&nbsp;</td><td>3S0336/7H3608</td><td>3/4"-16UNFX3/4"</td></tr>
            <tr><td>7/8"-14UNFX65</td><td>&nbsp;</td><td>&nbsp;</td><td>0.452</td><td>&nbsp;</td><td>&nbsp;</td><td>9S2727/7H3609</td><td>&nbsp;</td></tr>
            <tr><td>M18X1.5X61</td><td>G</td><td>b</td><td>0.234</td><td>100</td><td>23</td><td>131-27-42230</td><td>&nbsp;</td></tr>
            <tr><td>M22X1.5X70</td><td>G</td><td>b</td><td>0.436</td><td>50</td><td>22</td><td>154-27-12320/01803-02228</td><td>M22X1.5X28</td></tr>
            <tr><td>M22X1.5X73</td><td>&nbsp;</td><td>&nbsp;</td><td>0.470</td><td>&nbsp;</td><td>&nbsp;</td><td>154-27-12181/01803-02228</td><td>M22X1.5X28</td></tr>
            <tr><td>M24X1.5X80</td><td>GF</td><td>b</td><td>0.692</td><td>35</td><td>24</td><td>178-27-11150/01803-02430</td><td>M24X1.5X30</td></tr>
            <tr><td>M24X1.5X90</td><td>&nbsp;</td><td>&nbsp;</td><td>0.726</td><td>&nbsp;</td><td>&nbsp;</td><td>195-27-12632/01803-02430</td><td>M24X1.5X30</td></tr>
          </tbody>
        </table>
      </div>

      <header class="section-header" style="margin-top: var(--space-12);">
        <h2>Notas</h2>
      </header>
      <div class="data-table-wrapper">
        <table class="data-table notes-table">
          <tbody>
            <tr><th>Marca:</th><td>170</td></tr>
            <tr><th>Tamaño de Caja:</th><td>33X19X12cm</td></tr>
            <tr><th>Tratamiento Superficial:</th><td>Negro</td></tr>
            <tr><th>Capacidad Mecánica:</th><td>Pernos: Clase 10.9, resistencia mínima a la tracción 170,000 psi. Tuercas: Clase 10, totalmente templadas y revenidas para igualar la resistencia del perno</td></tr>
            <tr><td colspan="2" class="notes-paragraph">Todos los detalles de embalaje se utilizan solo como referencia. No podemos listar todos nuestros productos en la tabla anterior ya que abrimos moldes todos los días. También producimos fijaciones de alta resistencia de clase 12.9 mediante forja.</td></tr>
            <tr><th>Consulta del Comprador:</th><td>El cliente puede consultarnos por Medidas, Números OEM, Dibujos y muestras. El cliente debe informarnos la cantidad por envío.</td></tr>
                        <tr><th>Entrega:</th><td>35 días después de recibir el pago anticipado del comprador o L/C según cantidad y artículos.</td></tr>
            <tr><th>Embalaje:</th><td>Cajas sobre pallets.</td></tr>
            <tr><td colspan="2" class="notes-paragraph">Las órdenes OEM son bienvenidas.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container text-center">
      <h2>¿Necesita Pernos de Segmento?</h2>
      <p>Contáctenos con sus especificaciones. Fabricamos según dibujos OEM.</p>
      <div class="cta-actions">
        <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="mailto:Jason@carelong.com.cn?subject=Product%20Inquiry%20-%20Carelong%20Website" class="btn btn-outline-white btn-lg">Envíenos un Correo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = document.getElementById('productGallery');
    if (!gallery) return;

    const thumbs = Array.from(gallery.querySelectorAll('.thumb'));
    const stageImgs = Array.from(gallery.querySelectorAll('.stage-img'));
    const stages = Array.from(gallery.querySelectorAll('.gallery-stage'));
    let current = 0;

    function activate(idx) {
      if (idx === current) return;
      current = idx;
      thumbs.forEach((t) => t.classList.toggle('is-active', Number(t.dataset.index) === current));
      stageImgs.forEach((img) => {
        const isActive = Number(img.dataset.index) === current;
        img.classList.toggle('is-active', isActive);
        if (isActive) img.style.transformOrigin = 'center center';
      });
      stages.forEach((s) => s.classList.remove('is-zooming'));
    }

    thumbs.forEach((t) => {
      const idx = Number(t.dataset.index);
      t.addEventListener('mouseenter', () => activate(idx));
      t.addEventListener('focus', () => activate(idx));
      t.addEventListener('click', () => activate(idx));
    });

    stages.forEach((stage) => {
      stage.addEventListener('mouseenter', () => stage.classList.add('is-zooming'));
      stage.addEventListener('mouseleave', () => {
        stage.classList.remove('is-zooming');
        const active = stage.querySelector('.stage-img.is-active');
        if (active) {
          active.style.transformOrigin = 'center center';
        }
      });
      stage.addEventListener('mousemove', (e) => {
        const active = stage.querySelector('.stage-img.is-active');
        if (!active) return;
        const rect = stage.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        const cx = Math.max(0, Math.min(100, x));
        const cy = Math.max(0, Math.min(100, y));
        active.style.transformOrigin = cx + '% ' + cy + '%';
      });
    });
  });
</script>

<style>
.eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-secondary); margin-bottom: var(--space-3); }
.product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: start; }

.product-gallery { display: grid; grid-template-columns: 88px 1fr; gap: var(--space-4); align-items: start; }
.gallery-thumbs { display: flex; flex-direction: column; gap: var(--space-2); max-height: 480px; overflow-y: auto; padding-right: 4px; }
.thumb { all: unset; cursor: pointer; display: block; width: 88px; height: 88px; border-radius: var(--radius-md); border: 2px solid transparent; background: #fff; overflow: hidden; transition: border-color .2s ease, transform .18s ease, box-shadow .18s ease; }
.thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
.thumb:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(27,75,142,.18); }
.thumb.is-active { border-color: var(--color-primary); box-shadow: 0 4px 12px rgba(27,75,142,.25); transform: translateY(-1px); }

.gallery-stage { position: relative; background: #fff; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); overflow: hidden; aspect-ratio: 1 / 1; cursor: zoom-in; outline: none; }
.stage-arrow[hidden] { display: none; }
.stage-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: var(--space-4); opacity: 0; transition: opacity .25s ease; transform: scale(1); cursor: zoom-in; }
.stage-img.is-active { opacity: 1; }
.gallery-stage.is-zooming .stage-img.is-active { transform: scale(2); transition: transform .15s ease-out; }
.zoom-hint { position: absolute; bottom: var(--space-3); right: var(--space-4); padding: 4px 10px; border-radius: 100px; background: rgba(15, 48, 96, 0.7); color: #fff; font-size: 0.75rem; font-weight: 500; letter-spacing: .5px; pointer-events: none; }

.product-intro h2 { margin-bottom: var(--space-4); }
.product-intro p { color: var(--color-text-light); line-height: 1.7; }
.product-badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0; }
.badge { display: inline-block; background: rgba(27, 75, 142, 0.08); color: var(--color-primary); padding: var(--space-1) var(--space-3); border-radius: 100px; font-size: 0.8125rem; font-weight: 600; }
.product-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }

.spec-table { display: flex; flex-direction: column; gap: var(--space-2); }
.spec-table-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
.spec-row { display: flex; justify-content: space-between; padding: var(--space-4) var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.spec-table-grid .spec-row { flex-direction: column; gap: var(--space-1); }
.spec-table-grid .spec-name { font-weight: 600; color: var(--color-text); font-size: 0.875rem; text-transform: lowercase; }
.spec-table-grid .spec-value { color: var(--color-text); font-weight: 500; text-align: left; max-width: 100%; }
.spec-name { font-weight: 600; color: var(--color-text); }
.spec-value { color: var(--color-text-light); text-align: right; max-width: 60%; }

/* Data tables */
.data-table-wrapper { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); }
.data-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.data-table thead th { background: var(--color-primary); color: #fff; padding: var(--space-3) var(--space-4); text-align: left; font-weight: 600; white-space: normal; line-height: 1.4; }
.data-table tbody td { padding: var(--space-3) var(--space-4); border-top: 1px solid var(--color-border); color: var(--color-text); word-wrap: break-word; }
.data-table tbody tr:nth-child(even) td { background: rgba(27, 75, 142, 0.04); }
.data-table tbody tr:hover td { background: rgba(27, 75, 142, 0.08); }
.data-table tbody td:nth-child(n+3) { font-variant-numeric: tabular-nums; }

/* 8-column Segment Bolt Specifications table - auto layout for natural alignment */
.spec-table-8col { table-layout: auto; width: 100%; }
.spec-table-8col thead th { vertical-align: middle; text-align: center; white-space: nowrap; }
.spec-table-8col tbody td { vertical-align: middle; text-align: center; }
.spec-table-8col tbody td:nth-child(1) { text-align: left; }  /* Description */

/* Notes table */
.notes-table { font-size: 0.9375rem; table-layout: auto; width: 100%; }
.notes-table th { background: transparent; color: var(--color-text); padding: var(--space-3) var(--space-4); text-align: left; font-weight: 700; white-space: nowrap; vertical-align: top; word-wrap: break-word; border-top: 1px solid var(--color-border); }
.notes-table td { padding: var(--space-3) var(--space-4); border-top: 1px solid var(--color-border); color: var(--color-text); vertical-align: top; }
.notes-table tbody tr:nth-child(even) td { background: rgba(27, 75, 142, 0.04); }
.notes-paragraph { font-style: italic; color: var(--color-text-light); line-height: 1.7; padding: var(--space-4) var(--space-4) !important; }
.notes-table a { color: var(--color-primary); text-decoration: underline; }

.cta-band { background: var(--color-primary); color: #fff; }
.cta-band h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-band p { color: rgba(255,255,255,0.85); font-size: 1.125rem; margin-bottom: var(--space-6); }
.cta-actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }

@media (max-width: 768px) {
  .product-overview { grid-template-columns: 1fr; }
  .product-gallery { grid-template-columns: 72px 1fr; }
  .thumb { width: 72px; height: 72px; }
  .spec-row { flex-direction: column; gap: var(--space-1); }
  .spec-value { text-align: left; max-width: 100%; }
  .spec-table-grid { grid-template-columns: 1fr; }
}
</style>