---
---
<section class="hero">
  <div class="hero-bg">
    <div class="hero-pattern"></div>
  </div>
  <div class="hero-content container">
    <div class="hero-text">
      <span class="hero-badge">Manufacturer & Exporter - Xiamen, China</span>
      <h1 class="hero-title">
        High Tensile Fasteners & Auto Parts Manufacturer
      </h1>
      <p class="hero-subtitle">
        Xiamen Carelong Co., Ltd. is a manufacturer of bolts, nuts, forging parts, stamping parts, die casting parts, machining parts, and more. <strong class="iso-cert">ISO 9001</strong> certified, exporting worldwide.
      </p>
      <div class="hero-actions">
        <a href="/products/" class="btn btn-primary">View Products</a>
        <a href="/contact/" class="btn btn-outline-white">Get a Quote</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-icon">
        <span class="icon-gear">⚙</span>
        <span class="icon-bolt">🔩</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(135deg, #0f1621 0%, #1a2332 50%, #243044 100%);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  /* Background Pattern */
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(232,90,31,0.15) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(232,90,31,0.08) 0%, transparent 35%),
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 60px,
        rgba(255,255,255,0.02) 60px,
        rgba(255,255,255,0.02) 61px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 60px,
        rgba(255,255,255,0.02) 60px,
        rgba(255,255,255,0.02) 61px
      );
  }

  .hero-pattern::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(232,90,31,0.12) 0%, transparent 70%);
    border-radius: 50%;
  }

  .hero-pattern::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 60%);
    border-radius: 50%;
  }

  /* Hero Content */
  .hero-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
    padding: 5rem 0;
  }

  .hero-text {
    flex: 1;
    max-width: 600px;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(217, 119, 6, 0.2);
    border: 1px solid rgba(217, 119, 6, 0.4);
    color: #fcd34d;
    padding: 0.375rem 1rem;
    border-radius: 100px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: 2.25rem;
    letter-spacing: 0.01em;
  }

  .hero-subtitle .iso-cert {
    color: #ffffff;
    font-weight: 700;
  }

  /* CTA Buttons */
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .btn-primary {
    background-color: #e85a1f;
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(232,90,31,0.35);
  }

  .btn-primary:hover {
    background-color: #d44f1a;
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(232,90,31,0.45);
  }

  .btn-secondary {
    background-color: transparent;
    color: #ffffff;
    border: 2px solid rgba(255,255,255,0.3);
  }

  .btn-secondary:hover {
    background-color: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.5);
    transform: translateY(-2px);
  }

  /* Hero Visual */
  .hero-visual {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 280px;
    height: 280px;
  }

  .hero-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .icon-gear,
  .icon-bolt {
    position: absolute;
    font-size: 8rem;
    color: rgba(232,90,31,0.2);
    animation: float 6s ease-in-out infinite;
  }

  .icon-bolt {
    font-size: 5rem;
    color: rgba(255,255,255,0.1);
    animation-delay: -3s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(5deg); }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero {
      min-height: 450px;
    }

    .hero-content {
      flex-direction: column;
      text-align: center;
      padding: 4rem 0;
      gap: 2rem;
    }

    .hero-text {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual {
      width: 200px;
      height: 200px;
    }

    .icon-gear {
      font-size: 5rem;
    }

    .icon-bolt {
      font-size: 3rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 400px;
    }

    .hero-content {
      padding: 3rem 0;
    }

    .hero-title {
      font-size: 1.75rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      font-size: 0.9375rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-visual {
      display: none;
    }
  }
</style>