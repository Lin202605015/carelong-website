---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
---

<BaseLayout
  title="Estampado de Aleación de Aluminio — Piezas Estampadas Ligeras | Carelong"
  description="Piezas de estampado de aleación de aluminio para aplicaciones ligeras y resistentes a la corrosión. Blanks, disipadores, soportes y carcasas para electrónica y automoción."
>
  <Breadcrumb items={[
    { label: 'Productos', href: '/products' },
    { label: 'Piezas Estampadas', href: '/products/stamping-parts' },
    { label: 'Estampado de Aleación de Aluminio' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Estampado de Aleación de Aluminio</h1>
      <p>Piezas estampadas de aleación de aluminio ligeras</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Product Overview</p>
      <h2>Estampado de Aleación de Aluminio</h2>
      <p>Fabricamos componentes de estampado de aleación de aluminio que combinan ligereza con resistencia a la corrosión. Las piezas comunes incluyen disipadores, soportes, cajas y clips estructurales para electrónica y aligeramiento automotriz.</p>

      <div class="image-placeholder" style="border:2px dashed #cbd5e1; border-radius:12px; padding:48px 24px; text-align:center; color:#64748b; background:#f8fafc; margin:24px 0;">
        Images coming soon — to be uploaded
      </div>

      <div class="product-actions">
        <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
        <a href="/products/stamping-parts" class="btn btn-outline btn-lg">Volver a Piezas Estampadas</a>
      </div>
    </div>
  </section>
</BaseLayout>
