---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
---

<BaseLayout
  lang="es"
  title="Piezas de Plástico y Caucho - Fabricante y Exportador | Carelong"
  description="Fabricante de moldeo por inyección y piezas de caucho. Piezas moldeadas por inyección de plástico a medida, juntas de caucho, neumáticos sólidos."
>
  <Breadcrumb items={[
    { label: 'Productos', href: '/es/products' },
    { label: 'Piezas de Plástico y Caucho' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Piezas de Plástico y Caucho</h1>
      <p>Fabricante de moldeo por inyección y piezas de caucho.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-image" style="background: #fff; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); display:flex; align-items:center; justify-content:center; height: 400px; overflow:hidden;">
          <img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-01.webp" alt="Piezas de Plástico y Caucho" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
        </div>
        <div class="product-intro">
          <p class="eyebrow">Descripción del Producto</p>
          <h2>Piezas de Plástico y Caucho</h2>
          <p>Fabricante de moldeo por inyección y piezas de caucho. Piezas moldeadas por inyección de plástico a medida, juntas de caucho, neumáticos sólidos.</p>

          <div class="product-badges">
            <span class="badge">Moldeo por Inyección</span>
            <span class="badge">Moldeo de Caucho</span>
            <span class="badge">Diseño Personalizado</span>
            <span class="badge">Multimaterial</span>
          </div>

          <div class="product-actions">
            <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
            <a href="/es/products" class="btn btn-primary btn-lg">Todos los Productos</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Especificaciones</p>
        <h2>Especificaciones Técnicas</h2>
      </header>
      <div class="spec-table">
        <div class="spec-row">
          <div class="spec-name">Proceso</div>
          <div class="spec-value">Moldeo por inyección, moldeo por compresión, extrusión</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Material Plástico</div>
          <div class="spec-value">PP, PA, ABS, PC, POM, PBT, PEEK</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Material de Caucho</div>
          <div class="spec-value">NBR, EPDM, Silicone, NR, SBR, FKM</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Dureza Shore</div>
          <div class="spec-value">20A - 90A (caucho), 60D - 85D (plástico)</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Tratamiento Superficial</div>
          <div class="spec-value">Pintura, impresión, cromado, recubrimiento UV</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Aplicación</div>
          <div class="spec-value">Automoción, fontanería, médico, productos de consumo</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Galería de Productos</p>
        <h2>Fotos de Piezas de Plástico y Caucho</h2>
      </header>
            <div class="gallery-grid">
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-06.webp" alt="plástico y caucho 06" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-07.webp" alt="plástico y caucho 07" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-12.webp" alt="plástico y caucho 12" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-13.webp" alt="plástico y caucho 13" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-14.webp" alt="plástico y caucho 14" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-15.webp" alt="plástico y caucho 15" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/plastic-rubber-parts-16.webp" alt="plástico y caucho 16" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/微信图片_2020032410273711.webp" alt="plástico y caucho weixin 1" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/微信图片_2020032410273724.webp" alt="plástico y caucho weixin 2" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/微信图片_2020032410273732.webp" alt="plástico y caucho weixin 3" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/微信图片_2020032410273734.webp" alt="plástico y caucho weixin 4" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/plastic-rubber-parts/微信图片_2020032410273742.webp" alt="plástico y caucho weixin 5" loading="lazy" /></div>
            </div>
</section>
<section class="section cta-band">
    <div class="container text-center">
      <h2>¿Necesita Piezas de Plástico y Caucho?</h2>
      <p>Contáctenos para especificaciones y precios. Disponibles tamaños OEM y personalizados.</p>
      <div class="cta-actions">
        <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="mailto:Jason@carelong.com.cn?subject=Product%20Inquiry%20-%20Carelong%20Website" class="btn btn-outline-white btn-lg">Envíenos un Correo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-secondary); margin-bottom: var(--space-3); }
.product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
.product-intro h2 { margin-bottom: var(--space-4); }
.product-intro p { color: var(--color-text-light); }
.product-badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0; }
.badge { display: inline-block; background: rgba(27, 75, 142, 0.08); color: var(--color-primary); padding: var(--space-1) var(--space-3); border-radius: 100px; font-size: 0.8125rem; font-weight: 600; }
.product-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.spec-table { display: flex; flex-direction: column; gap: var(--space-2); }
.spec-row { display: flex; justify-content: space-between; padding: var(--space-4) var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.spec-name { font-weight: 600; color: var(--color-text); }
.spec-value { color: var(--color-text-light); text-align: right; }
.gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
.gallery-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; }
.gallery-item img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
.cta-band { background: var(--color-primary); color: #fff; }
.cta-band h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-band p { color: rgba(255,255,255,0.85); font-size: 1.125rem; margin-bottom: var(--space-6); }
.cta-actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
@media (max-width: 768px) {
  .product-overview { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .spec-row { flex-direction: column; gap: var(--space-1); }
  .spec-value { text-align: left; }
}
</style>