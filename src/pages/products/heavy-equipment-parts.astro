---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout
  title="Heavy Equipment Parts — Undercarriage Parts for CAT & Komatsu | Carelong"
  description="Undercarriage parts manufacturer for excavators and bulldozers. Track chains, sprockets, rollers, idlers. Compatible with CAT and Komatsu models."
>
  <Breadcrumb items={[
    { label: 'Products', href: '/products' },
    { label: 'Heavy Equipment Parts' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Heavy Equipment Parts</h1>
      <p>Undercarriage parts manufacturer for excavators and bulldozers.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-image" style="background: #fff; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); display:flex; align-items:center; justify-content:center; height: 400px; overflow:hidden;">
          <img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-01.webp" alt="Heavy Equipment Parts" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
        </div>
        <div class="product-intro">
          <p class="eyebrow">Product Overview</p>
          <h2>Heavy Equipment Parts</h2>
          <p>Undercarriage parts manufacturer for excavators and bulldozers. Track chains, sprockets, rollers, idlers.</p>

          <div class="product-badges">
            <span class="badge">Undercarriage</span>
            <span class="badge">Track Chains</span>
            <span class="badge">Rollers & Idlers</span>
            <span class="badge">OEM Service</span>
          </div>

          <div class="product-actions">
            <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
            <a href="/products" class="btn btn-primary btn-lg">All Products</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Specifications</p>
        <h2>Technical Specifications</h2>
      </header>
      <div class="spec-table">
        <div class="spec-row">
          <div class="spec-name">Product</div>
          <div class="spec-value">Undercarriage components for excavators and bulldozers</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Track Pitch</div>
          <div class="spec-value">171mm, 175mm, 190mm, 203mm, 216mm</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Compatible Brands</div>
          <div class="spec-value">Komatsu, Caterpillar, Hitachi, Volvo</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Material</div>
          <div class="spec-value">Forged steel, cast steel, manganese steel</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Heat Treatment</div>
          <div class="spec-value">Induction hardened, through-hardened</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Application</div>
          <div class="spec-value">Excavators, bulldozers, track loaders, pipelayers</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Product Gallery</p>
        <h2>Heavy Equipment Parts Photos</h2>
      </header>
            <div class="gallery-grid">
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-04.webp" alt="heavy equipment parts 04" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-05.webp" alt="heavy equipment parts 05" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-06.webp" alt="heavy equipment parts 06" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-07.webp" alt="heavy equipment parts 07" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-09.webp" alt="heavy equipment parts 09" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-12.webp" alt="heavy equipment parts 12" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-13.webp" alt="heavy equipment parts 13" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-15.webp" alt="heavy equipment parts 15" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-17.webp" alt="heavy equipment parts 17" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-18.webp" alt="heavy equipment parts 18" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-20.webp" alt="heavy equipment parts 20" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-22.webp" alt="heavy equipment parts 22" loading="lazy" /></div>
            </div>
</section>
<section class="section cta-band">
    <div class="container text-center">
      <h2>Need Heavy Equipment Parts?</h2>
      <p>Contact us for specifications and pricing. OEM and custom sizes available.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
        <a href="mailto:Jason@carelong.com.cn?subject=Product%20Inquiry%20-%20Carelong%20Website" class="btn btn-outline-white btn-lg">Email Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-secondary); margin-bottom: var(--space-3); }
.product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
.product-intro h2 { margin-bottom: var(--space-4); }
.product-intro p { color: var(--color-text-light); }
.product-badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0; }
.badge { display: inline-block; background: rgba(27, 75, 142, 0.08); color: var(--color-primary); padding: var(--space-1) var(--space-3); border-radius: 100px; font-size: 0.8125rem; font-weight: 600; }
.product-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.spec-table { display: flex; flex-direction: column; gap: var(--space-2); }
.spec-row { display: flex; justify-content: space-between; padding: var(--space-4) var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.spec-name { font-weight: 600; color: var(--color-text); }
.spec-value { color: var(--color-text-light); text-align: right; }
.gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
.gallery-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; }
.gallery-item img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
.cta-band { background: var(--color-primary); color: #fff; }
.cta-band h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-band p { color: rgba(255,255,255,0.85); font-size: 1.125rem; margin-bottom: var(--space-6); }
.cta-actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
@media (max-width: 768px) {
  .product-overview { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .spec-row { flex-direction: column; gap: var(--space-1); }
  .spec-value { text-align: left; }
}
</style>