---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const images = [
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-01.webp', alt: 'Plow Bolts product photo' },
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-02.webp', alt: 'Plow Bolts detail view' },
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-03.webp', alt: 'Plow Bolts application' },
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-04.webp', alt: 'Plow Bolts detail' },
  { src: '/images/products/bolts-and-nuts/plow-bolts/plow-bolt-05.webp', alt: 'Plow Bolts application scene' },
];
---

<BaseLayout
  title="Plow Bolts — Countersunk Head Bolts for Agricultural & Construction Machinery | Carelong"
  description="Manufacturer of plow bolts with flat countersunk head. Grade 8.8/10.9, high-grade steel. OEM service for agricultural implements and earthmoving equipment."
>
  <Breadcrumb items={[
    { label: 'Products', href: '/products' },
    { label: 'Bolts and Nuts', href: '/products/bolts-and-nuts' },
    { label: 'Plow Bolts' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Plow Bolts</h1>
      <p>Countersunk head bolts for agricultural and earthmoving equipment</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-gallery" id="productGallery">
          <div class="gallery-thumbs" aria-label="Product images">
            {images.map((img, i) => (
              <button
                type="button"
                class={`thumb ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                aria-label={`View image ${i + 1}`}
              >
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
          <div class="gallery-stage" id="galleryStage">
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class={`stage-img ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
            <button type="button" class="stage-arrow stage-arrow-prev" aria-label="Previous image" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="stage-arrow stage-arrow-next" aria-label="Next image" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="zoom-hint" aria-hidden="true">Hover to zoom & move</div>
          </div>
        </div>
        <div class="product-intro">
          <p class="eyebrow">Product Overview</p>
          <h2>Plow Bolts</h2>
          <p>Plow bolts feature a flat countersunk head that sits flush with the surface, ideal for agricultural implements and earthmoving equipment where protruding heads would cause interference. Manufactured from high-grade steel with heat treatment for durability.</p>

          <div class="product-badges">
            <span class="badge">Countersunk Head</span>
            <span class="badge">Grade 8.8/10.9</span>
            <span class="badge">DIN 608</span>
          </div>

          <div class="product-actions">
            <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
            <a href="/products/bolts-and-nuts" class="btn btn-outline btn-lg">Back to Bolts & Nuts</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
