---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
---

<BaseLayout
  lang="es"
  title="Piezas Forjadas — Fabricante y Exportador | Carelong"
  description="Fabricante de forja en caliente y en frío. Manguitos de oruga, fundas de cadena, cuerpos de tuercas grandes, engranajes, arandelas y piezas forjadas personalizadas."
>
  <Breadcrumb items={[
    { label: 'Productos', href: '/es/products' },
    { label: 'Piezas Forjadas' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Piezas Forjadas</h1>
      <p>Fabricante de forja en caliente y en frío.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-image" style="background: #fff; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); display:flex; align-items:center; justify-content:center; height: 400px; overflow:hidden;">
          <img src="/images/products/forging-parts/forging-parts-01.webp" alt="Piezas Forjadas" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
        </div>
        <div class="product-intro">
          <p class="eyebrow">Descripción del Producto</p>
          <h2>Piezas Forjadas</h2>
          <p>Fabricante de forja en caliente y en frío. Manguitos de oruga, fundas de cadena, cuerpos de tuercas grandes, engranajes, arandelas y piezas forjadas personalizadas.</p>

          <div class="product-badges">
            <span class="badge">Forja en Caliente</span>
            <span class="badge">Forja en Frío</span>
            <span class="badge">M12-M80</span>
            <span class="badge">Formas Personalizadas</span>
          </div>

          <div class="product-actions">
            <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
            <a href="/es/products" class="btn btn-primary btn-lg">Todos los Productos</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Especificaciones</p>
        <h2>Especificaciones Técnicas</h2>
      </header>
      <div class="spec-table">
        <div class="spec-row">
          <div class="spec-name">Proceso</div>
          <div class="spec-value">Forja en caliente, forja en frío, forja de precisión</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Rango Forjado en Caliente</div>
          <div class="spec-value">M12 —M80</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Rango Forjado en Frío</div>
          <div class="spec-value">0.8mm —28mm</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Material</div>
          <div class="spec-value">Acero al carbono, acero aleado, acero inoxidable</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Tratamiento Superficial</div>
          <div class="spec-value">Galvanizado, óxido negro, recubrimiento de fosfato</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Aplicación</div>
          <div class="spec-value">Equipo pesado, automoción, maquinaria de construcción</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Galería de Productos</p>
        <h2>Fotos de Piezas Forjadas</h2>
      </header>
      <div class="gallery-grid">
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-02.webp" alt="Piezas Forjadas 02" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-04.webp" alt="Piezas Forjadas 04" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-05.webp" alt="Piezas Forjadas 05" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-06.webp" alt="Piezas Forjadas 06" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-07.webp" alt="Piezas Forjadas 07" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-10.webp" alt="Piezas Forjadas 10" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-12.webp" alt="Piezas Forjadas 12" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-13.webp" alt="Piezas Forjadas 13" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-14.webp" alt="Piezas Forjadas 14" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-15.webp" alt="Piezas Forjadas 15" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-16.webp" alt="Piezas Forjadas 16" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/forging-parts/forging-parts-17.webp" alt="Piezas Forjadas 17" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container text-center">
      <h2>¿Necesita Piezas Forjadas?</h2>
      <p>Contáctenos para especificaciones y precios. Disponibles tamaños OEM y personalizados.</p>
      <div class="cta-actions">
        <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="mailto:Jason@carelong.com.cn?subject=Product%20Inquiry%20-%20Carelong%20Website" class="btn btn-outline-white btn-lg">Envíenos un Correo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-secondary); margin-bottom: var(--space-3); }
.product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
.product-intro h2 { margin-bottom: var(--space-4); }
.product-intro p { color: var(--color-text-light); }
.product-badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0; }
.badge { display: inline-block; background: rgba(27, 75, 142, 0.08); color: var(--color-primary); padding: var(--space-1) var(--space-3); border-radius: 100px; font-size: 0.8125rem; font-weight: 600; }
.product-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.spec-table { display: flex; flex-direction: column; gap: var(--space-2); }
.spec-row { display: flex; justify-content: space-between; padding: var(--space-4) var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.spec-name { font-weight: 600; color: var(--color-text); }
.spec-value { color: var(--color-text-light); text-align: right; }
.gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
.gallery-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; }
.gallery-item img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
.cta-band { background: var(--color-primary); color: #fff; }
.cta-band h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-band p { color: rgba(255,255,255,0.85); font-size: 1.125rem; margin-bottom: var(--space-6); }
.cta-actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
@media (max-width: 768px) {
  .product-overview { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .spec-row { flex-direction: column; gap: var(--space-1); }
  .spec-value { text-align: left; }
}
</style>