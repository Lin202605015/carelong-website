<script>
  (() => {
    const app = document.getElementById('oemApp');
    if (!app) return;
    const search = document.getElementById('oemSearch');
    const scroller = document.getElementById('oemScroll');
    const brands = Array.from(scroller.querySelectorAll('.oem-brand'));
    const countEl = document.getElementById('oemCount');
    const emptyEl = document.getElementById('oemEmpty');
    const tmpl = app.dataset.count;
    const haystacks = brands.map((b) => b.textContent.toLowerCase());

    function render() {
      const q = (search.value || '').trim().toLowerCase();
      let shown = 0;
      brands.forEach((b, i) => {
        const match = !q || haystacks[i].includes(q);
        b.hidden = !match;
        if (!match) return;
        shown++;
        b.querySelectorAll('.oem-lines span').forEach((s) => {
          s.classList.toggle('hit', !!q && s.textContent.toLowerCase().includes(q));
        });
      });
      countEl.textContent = tmpl.replace('__N__', String(shown));
      emptyEl.hidden = shown !== 0;
      if (q) scroller.scrollTop = 0;
    }

    search.addEventListener('input', render);
    render();
  })();
</script>
