  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-image" style="background: #fff; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); display:flex; align-items:center; justify-content:center; height: 400px; overflow:hidden;">
          <img src="/images/products/track-bushing-and-track-pin/track-bushing-and-track-pin-main.webp" alt="Track Pin and Bushing" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
        </div>
        <div class="product-intro">
          <p class="eyebrow">Product Overview</p>
          <h2>Track Bushing and Track Pin</h2>
          <p>Track pins and bushings are key connection parts in the undercarriage chain of excavators and bulldozers. We supply heat-treated alloy steel pins and bushings with OEM replacement and custom sizes.</p>

          <div class="product-badges">
            <span class="badge">Track Pins</span>
            <span class="badge">Track Bushings</span>
            <span class="badge">Heat-Treated Alloy Steel</span>
            <span class="badge">OEM Service</span>
          </div>

          <div class="product-actions">
            <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
            <a href="/products" class="btn btn-primary btn-lg">All Products</a>
          </div>
        </div>
      </div>
    </div>
  </section>

