---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
---

<BaseLayout
  title="Buje y Pasador de Oruga — Piezas de Tren de Rodaje | Carelong"
  description="Bujes y pasadores de oruga para excavadoras y buldóceres. Acero aleado tratado térmicamente, repuestos OEM para CAT, Komatsu y más."
>
  <Breadcrumb items={[
    { label: 'Productos', href: '/es/products' },
    { label: 'Buje y Pasador de Oruga' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Buje y Pasador de Oruga</h1>
      <p>Pasadores y bujes de tren de rodaje para excavadoras y buldóceres.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-image" style="background: #fff; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); display:flex; align-items:center; justify-content:center; height: 400px; overflow:hidden;">
          <img src="/images/products/track-bushing-and-track-pin/track-bushing-and-track-pin-main.webp" alt="Pasador y Buje de Oruga" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
        </div>
        <div class="product-intro">
          <p class="eyebrow">Descripción del Producto</p>
          <h2>Buje y Pasador de Oruga</h2>
          <p>Los pasadores y bujes de oruga son piezas clave de conexión en la cadena del tren de rodaje de excavadoras y buldóceres. Suministramos pasadores y bujes de acero aleado tratado térmicamente con repuestos OEM y medidas personalizadas.</p>

          <div class="product-badges">
            <span class="badge">Pasadores de Oruga</span>
            <span class="badge">Bujes de Oruga</span>
            <span class="badge">Acero Aleado Tratado</span>
            <span class="badge">Servicio OEM</span>
          </div>

          <div class="product-actions">
            <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
            <a href="/es/products" class="btn btn-primary btn-lg">Todos los Productos</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Especificaciones</p>
        <h2>Especificaciones Técnicas</h2>
      </header>
      <div class="spec-table">
        <div class="spec-row">
          <div class="spec-name">Producto</div>
          <div class="spec-value">Pasadores y bujes de oruga para tren de rodaje de orugas</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Material</div>
          <div class="spec-value">Acero aleado tratado térmicamente</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Tratamiento Térmico</div>
          <div class="spec-value">Endurecido por inducción / temple completo</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Marcas Compatibles</div>
          <div class="spec-value">CAT, Komatsu, Hitachi, Volvo, Hyundai</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Aplicación</div>
          <div class="spec-value">Excavadoras, buldóceres, cargadores de orugas</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Servicio</div>
          <div class="spec-value">Repuestos OEM y medidas personalizadas disponibles</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Galería de Productos</p>
        <h2>Fotos de Pasadores y Bujes de Oruga</h2>
      </header>
      <div class="gallery-grid">
        <div class="gallery-item"><img src="/images/products/track-bushing-and-track-pin/track-bushing-and-track-pin-main.webp" alt="pasador de oruga" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-22-v2.webp" alt="buje de oruga" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/heavy-equipment-parts/heavy-equipment-parts-18-v2.webp" alt="juego de pasador y buje de oruga" loading="lazy" /></div>
      </div>
    </div>
  </section>
  <section class="section cta-band">
    <div class="container text-center">
      <h2>¿Necesita Pasadores y Bujes de Oruga?</h2>
      <p>Contáctenos para especificaciones y precios. Disponibles servicios OEM y medidas personalizadas.</p>
      <div class="cta-actions">
        <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="mailto:Jason@carelong.com.cn?subject=Product%20Inquiry%20-%20Carelong%20Website" class="btn btn-outline-white btn-lg">Envíenos un Correo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-secondary); margin-bottom: var(--space-3); }
.product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
.product-intro h2 { margin-bottom: var(--space-4); }
.product-intro p { color: var(--color-text-light); }
.product-badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0; }
.badge { display: inline-block; background: rgba(27, 75, 142, 0.08); color: var(--color-primary); padding: var(--space-1) var(--space-3); border-radius: 100px; font-size: 0.8125rem; font-weight: 600; }
.product-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.spec-table { display: flex; flex-direction: column; gap: var(--space-2); }
.spec-row { display: flex; justify-content: space-between; padding: var(--space-4) var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.spec-name { font-weight: 600; color: var(--color-text); }
.spec-value { color: var(--color-text-light); text-align: right; }
.gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
.gallery-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; }
.gallery-item img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
.cta-band { background: var(--color-primary); color: #fff; }
.cta-band h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-band p { color: rgba(255,255,255,0.85); font-size: 1.125rem; margin-bottom: var(--space-6); }
.cta-actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
@media (max-width: 768px) {
  .product-overview { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .spec-row { flex-direction: column; gap: var(--space-1); }
  .spec-value { text-align: left; }
}
</style>
