---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
---

<BaseLayout
  lang="es"
  title="Piezas Estampadas — Fabricante y Exportador | Carelong"
  description="Fabricante de piezas de estampado personalizadas. Estampado de acero inoxidable y acero al carbono. Perforación CNC, doblado y estirado para aplicaciones automotrices e industriales."
>
  <Breadcrumb items={[
    { label: 'Productos', href: '/es/products' },
    { label: 'Piezas Estampadas' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Piezas Estampadas</h1>
      <p>Fabricante de piezas de estampado personalizadas.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-image" style="background: #fff; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); display:flex; align-items:center; justify-content:center; height: 400px; overflow:hidden;">
          <img src="/images/products/stamping-parts/stamping-parts-01.webp" alt="Piezas Estampadas" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
        </div>
        <div class="product-intro">
          <p class="eyebrow">Descripción del Producto</p>
          <h2>Piezas Estampadas</h2>
          <p>Fabricante de piezas de estampado personalizadas. Estampado de acero inoxidable y acero al carbono. Perforación CNC, doblado y estirado para aplicaciones automotrices e industriales.</p>

          <div class="product-badges">
            <span class="badge">Estampado de Precisión</span>
            <span class="badge">Acero Inoxidable</span>
            <span class="badge">Troquel Progresivo</span>
            <span class="badge">Diseño Personalizado</span>
          </div>

          <div class="product-actions">
            <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
            <a href="/es/products" class="btn btn-primary btn-lg">Todos los Productos</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Especificaciones</p>
        <h2>Especificaciones Técnicas</h2>
      </header>
      <div class="spec-table">
        <div class="spec-row">
          <div class="spec-name">Proceso</div>
          <div class="spec-value">Estampado progresivo, embutido profundo, perforación, doblado</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Material</div>
          <div class="spec-value">Acero inoxidable, acero al carbono, aluminio, cobre</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Espesor</div>
          <div class="spec-value">0.1mm —6mm</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Tolerancia</div>
          <div class="spec-value">±0.05mm</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Tratamiento Superficial</div>
          <div class="spec-value">Galvanizado, niquelado, anodizado, recubrimiento en polvo</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Aplicación</div>
          <div class="spec-value">Automoción, electrónica, electrodomésticos, equipo industrial</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Galería de Productos</p>
        <h2>Fotos de Piezas Estampadas</h2>
      </header>
            <div class="gallery-grid">
  <div class="gallery-item"><img src="/images/products/stamping-parts/stamping-parts-02.webp" alt="piezas estampadas 02" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/stamping-parts/stamping-parts-03.webp" alt="piezas estampadas 03" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/stamping-parts/stamping-parts-04.webp" alt="piezas estampadas 04" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/stamping-parts/stamping-parts-05.webp" alt="piezas estampadas 05" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/stamping-parts/stamping-parts-06.webp" alt="piezas estampadas 06" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/stamping-parts/stamping-parts-07.webp" alt="piezas estampadas 07" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/stamping-parts/stamping-parts-09.webp" alt="piezas estampadas 09" loading="lazy" /></div>
  <div class="gallery-item"><img src="/images/products/stamping-parts/stamping-parts-10.webp" alt="piezas estampadas 10" loading="lazy" /></div>
</div>
</section>
<section class="section cta-band">
    <div class="container text-center">
      <h2>¿Necesita Piezas Estampadas?</h2>
      <p>Contáctenos para especificaciones y precios. Disponibles tamaños OEM y personalizados.</p>
      <div class="cta-actions">
        <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
        <a href="mailto:Jason@carelong.com.cn?subject=Product%20Inquiry%20-%20Carelong%20Website" class="btn btn-outline-white btn-lg">Envíenos un Correo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-secondary); margin-bottom: var(--space-3); }
.product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
.product-intro h2 { margin-bottom: var(--space-4); }
.product-intro p { color: var(--color-text-light); }
.product-badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0; }
.badge { display: inline-block; background: rgba(27, 75, 142, 0.08); color: var(--color-primary); padding: var(--space-1) var(--space-3); border-radius: 100px; font-size: 0.8125rem; font-weight: 600; }
.product-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.spec-table { display: flex; flex-direction: column; gap: var(--space-2); }
.spec-row { display: flex; justify-content: space-between; padding: var(--space-4) var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.spec-name { font-weight: 600; color: var(--color-text); }
.spec-value { color: var(--color-text-light); text-align: right; }
.gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
.gallery-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; }
.gallery-item img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
.cta-band { background: var(--color-primary); color: #fff; }
.cta-band h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-band p { color: rgba(255,255,255,0.85); font-size: 1.125rem; margin-bottom: var(--space-6); }
.cta-actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
@media (max-width: 768px) {
  .product-overview { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .spec-row { flex-direction: column; gap: var(--space-1); }
  .spec-value { text-align: left; }
}
</style>