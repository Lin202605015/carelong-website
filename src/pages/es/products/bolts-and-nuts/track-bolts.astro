---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';

const images = [
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-01-v2.webp', alt: 'Foto del producto Pernos de Oruga' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-02-v2.webp', alt: 'Vista detallada de Pernos de Oruga' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-03-v2.webp', alt: 'Aplicación de Pernos de Oruga' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-04-v2.webp', alt: 'Detalle de Pernos de Oruga' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-05-v2.webp', alt: 'Escena de aplicación de Pernos de Oruga' },
];
---

<BaseLayout
  lang="es"
  title="Pernos de Oruga — Pernos de Eslabón de Cadena para Tren de Rodaje de Excavadoras y Bulldozers | Carelong"
  description="Fabricante de pernos de eslabón de cadena para el tren de rodaje de excavadoras y bulldozers. M14-M30, Grado 10.9/12.9, para CAT, Komatsu, Hitachi. Acero aleado de alta resistencia."
>
  <Breadcrumb items={[
    { label: 'Productos', href: '/es/products' },
    { label: 'Pernos y Tuercas', href: '/es/products/bolts-and-nuts' },
    { label: 'Pernos de Oruga' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Pernos de Oruga</h1>
      <p>Pernos de eslabón de cadena de alta resistencia para el tren de rodaje de excavadoras y bulldozers</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-gallery" id="productGallery">
          <div class="gallery-thumbs" aria-label="Imágenes del producto">
            {images.map((img, i) => (
              <button
                type="button"
                class={`thumb ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                aria-label={`Ver imagen ${i + 1}`}
              >
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
          <div class="gallery-stage" id="galleryStage">
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class={`stage-img ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
            <button type="button" class="stage-arrow stage-arrow-prev" aria-label="Imagen anterior" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="stage-arrow stage-arrow-next" aria-label="Imagen siguiente" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="zoom-hint" aria-hidden="true">Pase el cursor para ampliar y mover</div>
          </div>
        </div>
        <div class="product-intro">
          <p class="eyebrow">Descripción del Producto</p>
          <h2>Pernos de Oruga</h2>
          <p>Los pernos de eslabón de cadena son fijaciones críticas para los sistemas de tren de rodaje de excavadoras y bulldozers. Nuestros pernos de oruga se fabrican con acero aleado premium con tratamiento térmico de Grado 10.9/12.9, diseñados para soportar cargas extremas y condiciones de operación severas.</p>

          <div class="product-badges">
            <span class="badge">M14–M30</span>
            <span class="badge">Grado 10.9/12.9</span>
            <span class="badge">CAT y Komatsu</span>
            <span class="badge">Acero Aleado 42CrMo</span>
          </div>

          <div class="product-actions">
            <a href="/es/contact" class="btn btn-primary btn-lg">Solicitar Cotización</a>
            <a href="/es/products/bolts-and-nuts" class="btn btn-outline btn-lg">Volver a Pernos y Tuercas</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Especificaciones</p>
        <h2>Características Principales</h2>
      </header>
      <div class="spec-table spec-table-grid">
        <div class="spec-row"><div class="spec-name">tipo de rosca</div><div class="spec-value">Métrica y UNC/UNF, M14–M30</div></div>
        <div class="spec-row"><div class="spec-name">grado de resistencia</div><div class="spec-value">10.9, 12.9</div></div>
        <div class="spec-row"><div class="spec-name">material</div><div class="spec-value">Acero Aleado 42CrMo, 40Cr</div></div>
        <div class="spec-row"><div class="spec-name">tratamiento superficial</div><div class="spec-value">Negro, Recubrimiento de Zinc, Zinc Trivalente</div></div>
        <div class="spec-row"><div class="spec-name">marcas compatibles</div><div class="spec-value">CAT, Komatsu, Hitachi, Kobelco, Volvo, JCB</div></div>
        <div class="spec-row"><div class="spec-name">aplicación</div><div class="spec-value">Eslabones de cadena, Zapatas, Piñones, Rodillos</div></div>
      </div>

      <header class="section-header" style="margin-top: var(--space-12);">
