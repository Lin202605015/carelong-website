---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — 404"
  description="The page you are looking for could not be found."
>
  <section class="not-found-section">
    <div class="container text-center">
      <div class="not-found-content">
        <div class="not-found-number" aria-hidden="true">404</div>
        <div class="not-found-icon" aria-hidden="true">🔧</div>
        <h1>Page Not Found</h1>
        <p class="not-found-message">
          Sorry, the page you're looking for doesn't exist or has been moved.
        </p>
        <p class="not-found-sub">
          If you typed the URL directly, please check the spelling. If you clicked a link, it may have moved or expired.
        </p>

        <div class="not-found-actions">
          <a href="/" class="btn btn-primary btn-lg">Go to Homepage</a>
          <a href="/products" class="btn btn-primary btn-lg">Browse Products</a>
          <a href="/contact" class="btn btn-primary btn-lg">Contact Us</a>
        </div>

        <div class="not-found-suggestions">
          <p>You might be looking for:</p>
          <ul>
            <li><a href="/products">All Products</a> — Browse our full product catalog</li>
            <li><a href="/about">About Us</a> — Learn about Carelong</li>
            <li><a href="/capabilities">Capabilities</a> — View our manufacturing capabilities</li>
            <li><a href="/faq">FAQ</a> — Frequently asked questions</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.not-found-section {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-16) 0;
  background: var(--color-bg-alt);
}

.not-found-content {
  max-width: 600px;
  margin: 0 auto;
}

.not-found-number {
  font-size: clamp(5rem, 20vw, 10rem);
  font-weight: 900;
  color: var(--color-primary);
  opacity: 0.08;
  line-height: 1;
  margin-bottom: -1.5rem;
  letter-spacing: -4px;
  user-select: none;
}

.not-found-icon {
  font-size: 4rem;
  margin-bottom: var(--space-4);
}

.not-found-content h1 {
  font-size: 2rem;
  margin-bottom: var(--space-4);
  color: var(--color-primary);
}

.not-found-message {
  font-size: 1.125rem;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.not-found-sub {
  color: var(--color-text-muted);
  font-size: 0.9375rem;
  margin-bottom: var(--space-8);
}

.not-found-actions {
  display: flex;
  gap: var(--space-3);
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: var(--space-10);
}

.not-found-suggestions {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  text-align: left;
}

.not-found-suggestions > p {
  font-weight: 600;
  font-size: 0.875rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: var(--space-3);
}

.not-found-suggestions ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.not-found-suggestions li {
  font-size: 0.9375rem;
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
}

.not-found-suggestions li:last-child { border-bottom: none; }

.not-found-suggestions a {
  color: var(--color-primary);
  font-weight: 500;
  text-decoration: none;
}

.not-found-suggestions a:hover {
  text-decoration: underline;
}
</style>