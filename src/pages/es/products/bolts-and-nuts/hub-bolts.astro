---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';

const images = [
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-01.webp', alt: 'Foto del producto Pernos de Maza' },
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-02.webp', alt: 'Vista detallada de Pernos de Maza' },
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-03.webp', alt: 'Aplicación de Pernos de Maza' },
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-04.webp', alt: 'Detalle de Pernos de Maza' },
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-05.webp', alt: 'Escena de aplicación de Pernos de Maza' },
];
