---
interface Props {
  src: string;
  alt: string;
  width?: string;
  height?: string;
  class?: string;
  style?: string;
}

const { src, alt, width = '100%', height = 'auto', class: className = '', style = '' } = Astro.props;
---

<div class={`img-placeholder ${className}`} style={`width: ${width}; height: ${height}; ${style}`}>
  <img src={src} alt={alt} loading="lazy" />
  <div class="img-label">{alt}</div>
</div>

<style>
.img-placeholder {
  position: relative;
  background: var(--color-bg-alt, #f1f5f9);
  border-radius: var(--radius-lg, 0.75rem);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-placeholder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 0.5rem 1rem;
  background: linear-gradient(transparent, rgba(0,0,0,0.6));
  color: white;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
}
</style>