---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
---

<BaseLayout
  title="Galvanized & Aluzinc Stamping — Coated Sheet Stamping | Carelong"
  description="Galvanized and Aluzinc (55% Al-Zn) coated sheet stamping parts with superior corrosion resistance. Brackets, panels and enclosures for construction and outdoor use."
>
  <Breadcrumb items={[
    { label: 'Products', href: '/products' },
    { label: 'Stamping Parts', href: '/products/stamping-parts' },
    { label: 'Galvanized & Aluzinc Stamping' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Galvanized & Aluzinc Stamping</h1>
      <p>Galvanized and Aluzinc coated sheet stamping</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Product Overview</p>
      <h2>Galvanized & Aluzinc Stamping</h2>
      <p>We stamp galvanized and Aluzinc (55% aluminium-zinc) coated steel sheet into brackets, panels and enclosures that resist rust in harsh environments. Ideal for construction, HVAC and outdoor equipment.</p>

      <div class="image-placeholder" style="border:2px dashed #cbd5e1; border-radius:12px; padding:48px 24px; text-align:center; color:#64748b; background:#f8fafc; margin:24px 0;">
        Images coming soon — to be uploaded
      </div>

      <div class="product-actions">
        <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
        <a href="/products/stamping-parts" class="btn btn-outline btn-lg">Back to Stamping Parts</a>
      </div>
    </div>
  </section>
</BaseLayout>
