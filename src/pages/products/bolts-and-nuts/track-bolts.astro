---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const images = [
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-01.webp', alt: 'Track Bolts product photo' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-02.webp', alt: 'Track Bolts detail view' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-03.webp', alt: 'Track Bolts application' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-04.webp', alt: 'Track Bolts detail' },
  { src: '/images/products/bolts-and-nuts/track-bolts/track-bolt-05.webp', alt: 'Track Bolts application scene' },
];
---

<BaseLayout
  title="Track Bolts — Track Link Bolts for Excavator & Bulldozer Undercarriage | Carelong"
  description="Manufacturer of track link bolts for excavator and bulldozer undercarriage. M14-M30, Grade 10.9/12.9, for CAT, Komatsu, Hitachi. High tensile alloy steel."
>
  <Breadcrumb items={[
    { label: 'Products', href: '/products' },
    { label: 'Bolts and Nuts', href: '/products/bolts-and-nuts' },
    { label: 'Track Bolts' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Track Bolts</h1>
      <p>High tensile track link bolts for excavator and bulldozer undercarriage</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-gallery" id="productGallery">
          <div class="gallery-thumbs" aria-label="Product images">
            {images.map((img, i) => (
              <button
                type="button"
                class={`thumb ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                aria-label={`View image ${i + 1}`}
              >
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
          <div class="gallery-stage" id="galleryStage">
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class={`stage-img ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
            <button type="button" class="stage-arrow stage-arrow-prev" aria-label="Previous image" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="stage-arrow stage-arrow-next" aria-label="Next image" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="zoom-hint" aria-hidden="true">Hover to zoom & move</div>
          </div>
        </div>
        <div class="product-intro">
          <p class="eyebrow">Product Overview</p>
          <h2>Track Bolts</h2>
          <p>Track link bolts are critical fasteners for excavator and bulldozer undercarriage systems. Our track bolts are manufactured from premium alloy steel with heat treatment to Grade 10.9/12.9, designed to withstand extreme loads and harsh operating conditions.</p>

          <div class="product-badges">
            <span class="badge">M14–M30</span>
            <span class="badge">Grade 10.9/12.9</span>
            <span class="badge">CAT & Komatsu</span>
            <span class="badge">Alloy Steel 42CrMo</span>
          </div>

          <div class="product-actions">
            <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
            <a href="/products/bolts-and-nuts" class="btn btn-outline btn-lg">Back to Bolts & Nuts</a>
          </div>
        </div>
      </div>
    </div>
  </section>

