<script>
  (() => {
    const search = document.getElementById('oemSearch');
    const scroller = document.querySelector('.spec-xl-wrap');
    if (!search || !scroller) return;
    const rows = Array.from(scroller.querySelectorAll('tbody tr'));
    const cells = rows.map((r) => Array.from(r.querySelectorAll('td')));
    const haystacks = cells.map((cs) => cs.map((c) => c.textContent.toLowerCase()).join(' '));
    const countEl = document.getElementById('oemCount');
    const emptyEl = document.getElementById('oemEmpty');
    const tmpl = countEl.dataset.tmpl;
    const total = rows.length;
    function render() {
      const q = (search.value || '').trim().toLowerCase();
      let shown = 0;
      rows.forEach((row, i) => {
        const match = !q || haystacks[i].includes(q);
        row.hidden = !match;
        cells[i].forEach((cell) => cell.classList.toggle('hit', !!q && cell.textContent.toLowerCase().includes(q)));
        if (match) shown++;
      });
      countEl.textContent = tmpl.replace('__N__', String(shown)).replace('__T__', String(total));
      emptyEl.hidden = shown !== 0;
      if (q) scroller.scrollTop = 0;
    }
    search.addEventListener('input', render);
    render();
  })();
</script>
