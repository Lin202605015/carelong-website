---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

const images = [
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-01.webp', alt: 'Hub Bolts product photo' },
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-02.webp', alt: 'Hub Bolts detail view' },
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-03.webp', alt: 'Hub Bolts application' },
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-04.webp', alt: 'Hub Bolts detail' },
  { src: '/images/products/bolts-and-nuts/hub-bolts/hub-bolt-05.webp', alt: 'Hub Bolts application scene' },
];
---

<BaseLayout
  title="Hub Bolts — Wheel Hub Bolt Kits for Automotive & Heavy Equipment | Carelong"
  description="Manufacturer of wheel hub bolts and hub bolt assemblies. M18-M42, Grade 10.9/12.9, alloy steel 40Cr. OEM service for Nissan, Hino, Isuzu, Mitsubishi, Benz."
>
  <Breadcrumb items={[
    { label: 'Products', href: '/products' },
    { label: 'Bolts and Nuts', href: '/products/bolts-and-nuts' },
    { label: 'Hub Bolts' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Hub Bolts</h1>
      <p>Wheel hub bolt kits for automotive and heavy equipment applications</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-gallery" id="productGallery">
          <div class="gallery-thumbs" aria-label="Product images">
            {images.map((img, i) => (
              <button
                type="button"
                class={`thumb ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                aria-label={`View image ${i + 1}`}
              >
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
          <div class="gallery-stage" id="galleryStage">
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class={`stage-img ${i === 0 ? 'is-active' : ''}`}
                data-index={i}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
            <button type="button" class="stage-arrow stage-arrow-prev" aria-label="Previous image" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="stage-arrow stage-arrow-next" aria-label="Next image" hidden>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="zoom-hint" aria-hidden="true">Hover to zoom & move</div>
          </div>
        </div>
        <div class="product-intro">
          <p class="eyebrow">Product Overview</p>
          <h2>Hub Bolts</h2>
          <p>Our wheel hub bolts are precision-engineered for secure wheel attachment in automotive and heavy equipment applications. Made from premium alloy steel 40Cr with heat treatment, they offer superior tensile strength and fatigue resistance.</p>

          <div class="product-badges">
            <span class="badge">M18–M42</span>
            <span class="badge">Grade 10.9/12.9</span>
            <span class="badge">Alloy Steel 40Cr</span>
            <span class="badge">OEM Service</span>
          </div>

          <div class="product-actions">
            <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
            <a href="/products/bolts-and-nuts" class="btn btn-outline btn-lg">Back to Bolts & Nuts</a>
          </div>
        </div>
      </div>
    </div>
  </section>

