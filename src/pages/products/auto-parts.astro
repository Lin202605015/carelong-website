---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout
  title="Auto Parts — Hub Bolt Kits & U-Bolts for Japanese Trucks | Carelong"
  description="Xiamen Carelong manufactures wheel hub bolt kits, U-bolts, king pin kits for Isuzu, Hino, Mitsubishi Fuso, Nissan. Grade 10.9 and 12.9 high tensile auto fasteners."
>
  <Breadcrumb items={[
    { label: 'Products', href: '/products' },
    { label: 'Auto Parts' }
  ]} />

  <header class="page-header">
    <div class="container">
      <h1>Auto Parts</h1>
      <p>Premium wheel hub bolt kits, U-bolts, and king pin kits for Japanese and global commercial vehicles</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="product-overview">
        <div class="product-image" style="background: #fff; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); display:flex; align-items:center; justify-content:center; height: 400px; overflow:hidden;">
          <img src="/images/products/auto-parts/auto-parts-1.webp" alt="Auto Parts - Wheel Hub Bolt Kits" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
        </div>
        <div class="product-intro">
          <p class="eyebrow">Product Overview</p>
          <h2>Automotive Fasteners & Parts</h2>
          <p>Xiamen Carelong is a specialized manufacturer of high tensile automotive fasteners and replacement parts for commercial vehicles. Our core product lines include wheel hub bolt kits, U-bolts, and king pin kits designed primarily for Japanese truck brands — Isuzu, Hino, Mitsubishi Fuso, and Nissan Diesel. With over 20 years of manufacturing experience, we produce parts that meet or exceed OEM specifications in strength, precision, and durability.</p>
          <p>Every component undergoes rigorous multi-stage inspection, from raw material testing to finished product verification. Our cold heading and hot forging capabilities allow us to produce fasteners in grades 8.8, 10.9, and 12.9, suitable for the most demanding automotive applications including wheel mounting, suspension systems, and steering assemblies.</p>

          <div class="product-badges">
            <span class="badge">Hub Bolt Kits</span>
            <span class="badge">U-Bolts</span>
            <span class="badge">King Pin Kits</span>
            <span class="badge">Grade 10.9 & 12.9</span>
          </div>

          <div class="product-actions">
            <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
            <a href="/products" class="btn btn-primary btn-lg">All Products</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Specifications</p>
        <h2>Technical Specifications</h2>
      </header>
      <div class="spec-table">
        <div class="spec-row">
          <div class="spec-name">Product Range</div>
          <div class="spec-value">Wheel hub bolt kits, U-bolts, king pin kits, wheel nuts, stud bolts</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Compatible Brands</div>
          <div class="spec-value">Isuzu, Hino, Mitsubishi Fuso, Nissan Diesel, Mercedes-Benz, Volvo</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Material</div>
          <div class="spec-value">Carbon steel 45#, alloy steel 40Cr, ML20MnTiB</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Strength Grade</div>
          <div class="spec-value">8.8, 10.9, 12.9 (high tensile class)</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Surface Treatment</div>
          <div class="spec-value">Zinc plated, phosphate, black oxide, Dacromet</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Thread Standard</div>
          <div class="spec-value">Metric (M10–M30), JIS, DIN, custom specs</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Manufacturing Process</div>
          <div class="spec-value">Cold heading, hot forging, CNC machining, thread rolling</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Application</div>
          <div class="spec-value">Truck wheel hubs, suspension systems, steering, chassis assembly</div>
        </div>
        <div class="spec-row">
          <div class="spec-name">Certification</div>
          <div class="spec-value">ISO 9001, SGS tested, OEM approved</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow">Product Gallery</p>
        <h2>Auto Parts Photos</h2>
      </header>
      <div class="gallery-grid">
        <div class="gallery-item"><img src="/images/products/auto-parts/auto-parts-04.webp" alt="auto parts 04" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/auto-parts-05.webp" alt="auto parts 05" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/auto-parts-06.webp" alt="auto parts 06" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/auto-parts-07.webp" alt="auto parts 07" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/auto-parts-12.webp" alt="auto parts 12" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/auto-parts-13.webp" alt="auto parts 13" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/auto-parts-17.webp" alt="auto parts 17" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/auto-parts-20.webp" alt="auto parts 20" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/SNV30473.webp" alt="auto parts SNV30473" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/SNV30480.webp" alt="auto parts SNV30480" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/SNV30483.webp" alt="auto parts SNV30483" loading="lazy" /></div>
        <div class="gallery-item"><img src="/images/products/auto-parts/SNV30489.webp" alt="auto parts SNV30489" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container text-center">
      <h2>Need Auto Parts?</h2>
      <p>Contact us for specifications and pricing. OEM and custom sizes available.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary btn-lg">Request a Quote</a>
        <a href="mailto:Jason@carelong.com.cn?subject=Product%20Inquiry%20-%20Carelong%20Website" class="btn btn-outline-white btn-lg">Email Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.eyebrow { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--color-secondary); margin-bottom: var(--space-3); }
.product-overview { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
.product-intro h2 { margin-bottom: var(--space-4); }
.product-intro p { color: var(--color-text-light); }
.product-badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0; }
.badge { display: inline-block; background: rgba(27, 75, 142, 0.08); color: var(--color-primary); padding: var(--space-1) var(--space-3); border-radius: 100px; font-size: 0.8125rem; font-weight: 600; }
.product-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.spec-table { display: flex; flex-direction: column; gap: var(--space-2); }
.spec-row { display: flex; justify-content: space-between; padding: var(--space-4) var(--space-6); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
.spec-name { font-weight: 600; color: var(--color-text); }
.spec-value { color: var(--color-text-light); text-align: right; }
.gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); }
.gallery-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; }
.gallery-item img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
.cta-band { background: var(--color-primary); color: #fff; }
.cta-band h2 { color: #fff; margin-bottom: var(--space-4); }
.cta-band p { color: rgba(255,255,255,0.85); font-size: 1.125rem; margin-bottom: var(--space-6); }
.cta-actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
@media (max-width: 768px) {
  .product-overview { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .spec-row { flex-direction: column; gap: var(--space-1); }
  .spec-value { text-align: left; }
}
</style>
